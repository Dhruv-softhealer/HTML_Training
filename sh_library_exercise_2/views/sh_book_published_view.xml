<odoo>
    <record id="sh_book_borrow_list_view" model="ir.ui.view">
        <field name="name">Books</field>
        <field name="model">sh.book.published</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"></field>
                <field name="author_name" />
                <field name="published_date" />
                <field name="age" />
            </list>
        </field>
    </record>

    <record id="sh_book_borrow_form_view" model="ir.ui.view">
        <field name="name">Books</field>
        <field name="model">sh.book.published</field>
        <field name="arch" type="xml">
            <form string="Books">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="author_name" />
                        </group>
                        <group>
                            <field name="published_date" />
                            <field name="age" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_book_borrow_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">sh.book.published</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sh_books_action" name="Book Borrow" action="sh_book_borrow_action"></menuitem>

</odoo>