<odoo>
        <record id="sh_sale_order_smartbutton_inherited" model="ir.ui.view">
            <field name="name">sh.sale.order.smartbutton.inherited</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
             
                <div name="button_box" position="inside">
                    <button name="action_get_sales_record"
                        icon="fa-product-hunt" 
                        class="oe_stat_button"
                        type="object">
                        <div class="o_field_widget o_stat_info">
                            <field name="product_count" string="Products" widget="statinfo"/>
                        </div>
                    </button>
                </div>
                
            </field> 
        </record>
    
    <record id="sh_smart_root_action" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>