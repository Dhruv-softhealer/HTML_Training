<odoo>

    <record id="sh_employee_list_view" model="ir.ui.view">
        <field name='name'>sh.employee.list.view</field>
        <field name="model">sh.employee</field>
        <field name="arch" type="xml">
            <list string="Employees">
                <field name="name" />
                <field name="job_id" />
                <field name="department_id" />
            </list>
        </field>
    </record>

    <record id="sh_employee_form_view" model="ir.ui.view">
        <field name='name'>sh.employee.form.view</field>
        <field name="model">sh.employee</field>
        <field name="arch" type="xml">
            <form string="Department Details">
                <group>
                    <field name="name" />
                </group>
                <group string="Many to One fields">
                    <field name="user_id" />
                    <field name="country_id" />
                    <field name="country_of_birth" />
                    <field name="job_id" />
                    <field name="department_id" />
                </group>
            </form>
        </field>
    </record>

    <record id="sh_employee_action" model="ir.actions.act_window">
        <field name='name'>Employee</field>
        <field name="res_model">sh.employee</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>