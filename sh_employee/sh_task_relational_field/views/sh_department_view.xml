<odoo>

    <record id="sh_department_list_view" model="ir.ui.view">
        <field name='name'>sh.department.list.view</field>
        <field name="model">sh.department</field>
        <field name="arch" type="xml">
            <list string="Departments">
                <field name="name" />
                <field name="complete_name" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>   
    
    <record id="sh_department_form_view" model="ir.ui.view">
        <field name='name'>sh.department.form.view</field>
        <field name="model">sh.department</field>
        <field name="arch" type="xml">
            <form string="Department Details">
                <group>
                    <field name="name" />
                    <field name="complete_name" />
                    <field name="active" widget="boolean_toggle" />
                </group>

                <group string="Many to One Fields">
                    <field name="manager_id" />
                    <field name="parent_id" />
                </group>    
                
                <notebook string="One to Many Fields">
                    <page string="Child Departments">
                        <field name="childs_ids" />
                    </page>
                    <page string="Jobs">
                        <field name="jobs_ids" />
                    </page>
                    <page string="Members">
                        <field name="members_ids" />
                    </page>
                </notebook>
            </form>
        </field>
    </record>    
    
    <record id="sh_department_action" model="ir.actions.act_window">
        <field name='name'>Department</field>
        <field name="res_model">sh.department</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>