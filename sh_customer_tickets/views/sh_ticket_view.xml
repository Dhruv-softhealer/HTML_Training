<odoo>


    <!-- ===================== TICKET LIST VIEW ========================= -->

    <record id="sh_ticket_list_view" model="ir.ui.view">
        <field name="name">sh_ticket</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <list string="Ticket">
                <header>
                    <button name="action_to_open_wizard" type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o" string='Open Wizard' >
                    </button>
                </header>
                <field name="name"></field>
                <field name="priority" widget="priority"></field>
                <field name="customer_id"></field>
                <field name="dev_id"></field>
                <field name="state" widget='badge'></field>
            </list>
        </field>
    </record>


