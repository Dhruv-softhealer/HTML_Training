    <!-- ===================== TICKET SMART BUTTON ========================= -->

    <record id='sh_ticket_smart_btn' model='ir.ui.view'>
        <field name='name'>Ticket BTN</field>
        <field name='model'>res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"></field>
        <field name='arch' type='xml'>
            <div class="oe_button_box" name="button_box">
                <button name="action_get_tickets" type="object" class="oe_stat_button"
                    icon="fa-pencil-square-o">
                    Tickets
                </button>
            </div>
        </field>
    </record>


    <!-- ===================== TICKET FORM VIEW ========================= -->

    <record id='sh_ticket_form_view' model='ir.ui.view'>
        <field name='name'>sh_ticket</field>
        <field name='model'>support.ticket</field>
        <field name='arch' type='xml'>
            <form string="Ticket">
                <sheet>
                    <header>
                        <field name="state" widget="statusbar"></field>

                        <button name="set_ticket_to_start"
                            string="Start" type="object" class="btn-primary"
                            invisible="state != 'new'" />

                        <button name="set_ticket_to_resolved"
                            string="Resolve" type="object" class="btn-primary"
                            invisible="state != 'in_progress'" />

                        <button name="set_ticket_to_closed"
                            groups="sh_customer_tickets.access_support_leader"
                            string="Close" type="object" class="btn-primary"
                            invisible="state == 'closed' or state == 'cancel'" />

                        <button name="set_ticket_to_cancel"
                            string="Cancel" type="object" class="btn-primary"
                            invisible="state == 'closed' or state == 'cancel'" />

                    </header>
                    

                    <div class="oe_button_box" name="button_box">
                        <button name="get_invoices" type="object" class="oe_stat_button"
                            icon="fa-pencil-square-o" invisible="not invoice_ids">
                            Invoice
                        </button>
                    </div>

                    <group>
                        <field name="name"></field>
                        <field name="user_id"></field>
                        <field name="priority" widget="priority"></field>
                        <field name="dev_id"></field>
                        <field name="customer_id"></field>
                        <field name="state" widget='badge'></field>
                    </group>
                </sheet>

            </form>
        </field>
    </record>


    <!-- ========================== KANBAN VIEW ======================= -->

    <record id="ticket_kanban_view" model="ir.ui.view">
        <field name="name">ticket.kanban.view</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">

                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <field class="fw-bolder" name="name" />
                            </div>
                            <div class="col-4 text-end">
                                <field name="state" widget="badge"></field>
                            </div>

                            <div class="col-8">
                                <field class="fw-bolder" name="dev_id" />
                            </div>

                        </div>
                        <div>
                            <field name="priority" widget="priority" />
                        </div>

                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- ========================== SEARCH VIEW ======================= -->

    <record id="ticket_search_view" model="ir.ui.view">
        <field name="name">ticket.view.search</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name='name' />
                <filter name='priority' string='Priority High' domain="[('priority','=','2')]" />
            </search>
        </field>
    </record>

    <!-- ========================== PIVOT VIEW ======================= -->

    <record id="ticket_pivot_view" model="ir.ui.view">
        <field name="name">ticket.view.pivot</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="customer_id" type="row" />
                <field name="dev_id" type="col" />

            </pivot>
        </field>
    </record>


    <!-- ========================== CALENDAR VIEW ======================= -->

    <record model="ir.ui.view" id="ticket_calendar_view">
        <field name="name">ticket.calendar</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <calendar
                event_open_popup="true"
                quick_create="0"
                date_start="date_begin"
                date_stop="date_end"
                string="Event Organization"
                mode="month"
                event_limit="2">
                <field name="name" />
                <field name="priority" />
                <field name="dev_id" />
                <field name="customer_id" />
                <field name="state" />
            </calendar>
        </field>
    </record>


    <!-- ========================== ACTIVITY VIEW ======================= -->

    <record id="ticket_activity_view" model="ir.ui.view">
        <field name="name">activity.view.activity</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <activity string="Ticket Activity">
                <templates>
                    <div t-name="activity-box" class="d-block">
                        <div class="d-flex justify-content-between">
                            <field name="name" string="Entry Name" class="o_text_block o_text_bold" />
                            <div class="m-1" />
                        </div>
                        <div class="d-flex justify-content-between">
                            <field name="dev_id" string="Developer Name"
                                class="o_text_block" />
                            <div class="m-1" />
                            <field name="state" widget="badge" decoration-info="state == 'new'"
                                decoration-success="state == 'resolved'" />
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- ========================== Form View For Button to change status ======================= -->

    <record id='sh_ticket_wizard_form_view' model='ir.ui.view'>
        <field name='name'>sh_tickets</field>
        <field name='model'>ticket.update.wizard</field>
        <field name='arch' type='xml'>
            <form string="Ticketss">
                <sheet>
                    <group>
                        <field name="status"></field>
                    </group>

                </sheet>
                <footer>
                    <button name="update_ticket_status" type="object"
                        class="bg-info">
                        Change Status </button>
                </footer>
            </form>
        </field>
    </record>


    <!-- ===================== TICKET ACTION ========================= -->

    <record id='sh_ticket_action_view' model='ir.actions.act_window'>
        <field name="name">Ticket</field>
        <field name="res_model">support.ticket</field>
        <field name="view_mode">list,form,kanban,pivot,calendar,activity</field>
    </record>
</odoo>