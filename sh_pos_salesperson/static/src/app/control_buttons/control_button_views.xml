<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_sale.ControlButtonsSH" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
            <!-- <t  t-esc="console.log('==================>>>>>>>>>>>>',this)" /> -->
            <button t-if="this.pos.config.sh_pos_allow_salesperson" t-att-class="buttonClass" t-on-click="() => this.onClickSalesperson()">
                <i class="fa fa-users" role="img" aria-label="Set Salesperson" title="Set Salesperson" /> Salesperson
            </button>
        </xpath>
    </t>
</templates>
