<odoo>
    <record id="pos_order_add_salesperson_view" model="ir.ui.view">
        <field name="name">pos.order.add.salesperson.view</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/list/field[@name='product_id']" position="after">
                <field name="sh_salesperson_id" />
            </xpath>
        </field>
    </record>
</odoo>