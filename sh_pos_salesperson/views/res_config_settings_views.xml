<odoo>
    <record id="allow_sales_person_config_view" model="ir.ui.view">
        <field name="name">res.config.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='is_order_shared']" position="after">
                <setting id="allow_salesperson"
                    title="Set salesperson on pos orderline"
                    string="Allow Salesperson"
                    help="Set salesperson on pos orderline">
                    <field name="sh_allow_salesperson" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>