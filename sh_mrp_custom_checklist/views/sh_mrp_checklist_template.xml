<odoo>
    <record id="sh_mrp_checklist_template_list_view" model="ir.ui.view">
        <field name="name">MRP Custom Checklist</field>
        <field name="model">sh.mrp.custom.checklist.template</field>
        <field name="arch" type="xml">
            <list string="MRP Custom Checklist Template">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="sh_checklist"  widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="sh_mrp_checklist_template_form_view" model="ir.ui.view">
        <field name="name">MRP Custom Checklist Template</field>
        <field name="model">sh.mrp.custom.checklist.template</field>
        <field name="arch" type="xml">
            <form string="MRP Custom Checklist Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="company_id" />
                        </group>
                        <group>
                            <field name="sh_checklist"  widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="sh_mrp_checklist_template_search_view" model="ir.ui.view">
        <field name="name">sh.mrp.custom.checklist.template</field>
        <field name="model">sh.mrp.custom.checklist.template</field>
        <field name="arch" type="xml">
            
            <search>
                <filter string="Checklist Template" name="group_by_template" context="{'group_by': 'sh_checklist'}"/>
            </search>

        </field>
    </record>


    <record id="sh_mrp_checklist_template_action_view" model="ir.actions.act_window">
        <field name="name">MRP Custom Checklist Template</field>
        <field name="res_model">sh.mrp.custom.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="sh_mrp_checklist_template_menuitems"
            parent="mrp.menu_mrp_configuration"
            name="MRP Custom Checklist Template"
            groups='sh_mrp_custom_checklist_access_group'
            action="sh_mrp_checklist_template_action_view" />
</odoo>