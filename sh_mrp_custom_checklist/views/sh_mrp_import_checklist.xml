<odoo>
    <record id="sh_mrp_checklist_import_form_view" model="ir.ui.view">
        <field name="name">MRP Custom Checklist Impoprt</field>
        <field name="model">sh.mrp.import.checklist</field>
        <field name="arch" type="xml">
            <form string="MRP Custom Checklist Import">
                <sheet>
                    <group>
                        <group>
                            <field name="import_type" widget="radio" />
                            <field name="company_id" />
                            <field name="file" />
                        </group>
                    </group>
                    <footer>
                        <button name="apply_button" type="object" class="btn btn-primary" string="Apply"></button>
                        <button string="Cancel" special="cancel"></button>
                    </footer>
                </sheet>

            </form>
        </field>
    </record>


    <record id="sh_mrp_import_checklist_action_view" model="ir.actions.act_window">
        <field name="name">MRP Import Checklist</field>
        <field name="res_model">sh.mrp.import.checklist</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
            id="sh_mrp_import_checklist_menuitems"
            parent="mrp.menu_mrp_configuration"
            name="Import MRP Custom Checklist"
            groups='sh_mrp_custom_checklist_access_group'
            action="sh_mrp_import_checklist_action_view" />
</odoo>