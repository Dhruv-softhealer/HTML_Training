<odoo>

    <record id='sh_sale_custom_inherited_form' model='ir.ui.view'>
        <field name='name'>sh.sale.custom.inherited.form</field>
        <field name='model'>sale.order</field>
        <field name='inherit_id' ref='sale.view_order_form' />
        <field name='arch' type='xml'>
            
            <xpath expr="//field[@name='payment_term_id']" position='after'>
                <field name='custom_note' widget='many2many_tags'/>
            </xpath>

            <!-- <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position='before'>
                <field name='custom_note' />
            </xpath> -->
        </field>
    </record>

    
    <record id='sh_note_action' model='ir.actions.act_window'>
        <field name='name'>Notes</field>
        <field name='res_model'>sh.note</field>
        <field name='view_mode'>list,form</field>
    </record>



    <!-- Menuitems -->
    <menuitem id='sh_note_root_menu'  action='sh_note_action' parent='sale.menu_sale_config' />
</odoo>