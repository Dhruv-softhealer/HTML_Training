<odoo>
    <record id="sh_product_list_view" model="ir.ui.view">
        <field name="name">Product</field>
        <field name="model">sh.product</field>
        <field name="arch" type="xml">
            <list string="Product">
                <field name="name"></field>
            </list>
        </field>
    </record>

    <record id="sh_res_partner_form_view" model="ir.ui.view">
        <field name="name">Product</field>
        <field name="model">sh.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_product_action" model="ir.actions.act_window">
        <field name="name">Product</field>
        <field name="res_model">sh.product</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>