<odoo>
    <record id="sh_sale_order_list_view" model="ir.ui.view">
        <field name="name">Sale_order</field>
        <field name="model">sh.sale.order</field>
        <field name="arch" type="xml">
            <list string="Sale_order">
                <field name="name"></field>
            </list>
        </field>
    </record>

    <record id="sh_sale_order_form_view" model="ir.ui.view">
        <field name="name">Sale_order</field>
        <field name="model">sh.sale.order</field>
        <field name="arch" type="xml">
            <form string="Sale_order">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="partner_id"/>
                        <field name="order_line_ids">
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_sale_order_action" model="ir.actions.act_window">
        <field name="name">Sale_order</field>
        <field name="res_model">sh.sale.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>