<odoo>
    <record id="sh_sale_order_line_list_view" model="ir.ui.view">
        <field name="name">Sale_order_line</field>
        <field name="model">sh.sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Sale_order_line">
                <field name="name"></field>
            </list>
        </field>
    </record>

    <record id="sh_sale_order_line_form_view" model="ir.ui.view">
        <field name="name">Sale_order_line</field>
        <field name="model">sh.sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Sale_order_line">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="tax_ids"/>
                        <field name="order_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_sale_order_line_action" model="ir.actions.act_window">
        <field name="name">Sale_order_line</field>
        <field name="res_model">sh.sale.order.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>