<odoo>

    <record id='sh_sale_custom_inherited_form' model='ir.ui.view'>
        <field name='name'>sh.sale.custom.inherited.form</field>
        <field name='model'>sale.order</field>
        <field name='inherit_id' ref='sale.view_order_form' />
        <field name='arch' type='xml'>

            <xpath expr="//field[@name='payment_term_id']" position='after'>
                <field name='custom_notes' widget='many2many_tags' />
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position='before'>
                <field name='custom_note'></field>
            </xpath>
        </field>
    </record>

    <record id='sh_sale_custom_inherited_list' model='ir.ui.view'>
        <field name='name'>sh.sale.custom.inherited.list</field>
        <field name='model'>sale.order</field>
        <field name='inherit_id' ref='sale.view_quotation_tree_with_onboarding' />
        <field name='arch' type='xml'>

            <xpath expr="//field[@name='state']" position="after">
                <field name="custom_notes"></field>
            </xpath>
            
        </field>
    </record>

    <!-- <record id='sh_sale_custom_inherited_kanban' model='ir.ui.view'>
        <field name='name'>sh.sale.custom.inherited.kanban</field>
        <field name='model'>sale.order</field>
        <field name='inherit_id' ref='sale.view_sale_order_pivot' />
        <field name='arch' type='xml'>

            <xpath expr="//pivot/field[@name='date_order']" position='after'>
                <field name='count'></field>
            </xpath>
            
        </field>
    </record> -->

    
    <record id='sh_note_action' model='ir.actions.act_window'>
        <field name='name'>Notes</field>
        <field name='res_model'>sh.note</field>
        <field name='view_mode'>list,form</field>
    </record>



    <!-- Menuitems -->
    <menuitem id='sh_note_root_menu' name="Custom Sale" action='sh_note_action' parent='sale.menu_sale_config' />
</odoo>