                <field name="stu_ids"></field>
            </list>
        </field>
    </record>

    <record id="sh_student_form_view" model="ir.ui.view">
        <field name="name">Degree</field>
        <field name="model">sh.degree</field>
        <field name="arch" type="xml">
            <form string="Degree">
                <field name="stu_ids"></field>
            </form>
        </field>
    </record> -->

    <record id="sh_student_act" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">sh.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="sh_degree_act" model="ir.actions.act_window">
        <field name="name">Degree</field>
        <field name="res_model">sh.degree</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Student"
        id="sh_student"
        action="sh_student_act">

    </menuitem>
    <!-- <menuitem name="Degree" id="sh_degree" action="sh_degree_act"></menuitem> -->
</odoo>