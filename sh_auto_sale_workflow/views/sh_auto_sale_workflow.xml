<odoo>
    <record id="sh_auto_sale_workflow_list_view" model="ir.ui.view">
        <field name="name">Auto Sale Workflow</field>
        <field name="model">sh.auto.sale.workflow</field>
        <field name="arch" type="xml">
            <list string="Auto Sale Workflow">
                <field name="name"/>
                <field name="val_order" widget="boolean_toggle"/>
                <field name="force_transfer" widget="boolean_toggle"/>
                <field name="create_invoice" widget="boolean_toggle"/>
                <field name="val_invoice" widget="boolean_toggle"/>
                <field name="register_payment" widget="boolean_toggle"/>
                <field name="send_invoice_by_email" widget="boolean_toggle"/>
                <field name="sh_sale_journal" />
                <field name="payment_journal"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="sh_auto_sale_workflow_form_view" model="ir.ui.view">
        <field name="name">Auto Sale Workflow</field>
        <field name="model">sh.auto.sale.workflow</field>
        <field name="arch" type="xml">
            <form string="Auto Sale Workflow">
                <sheet>
                    <field name="name"/>
                    <group>
                        <group string="WORKFLOW OPTION">
                        <field name="val_order"/>
                        <field name="force_transfer" invisible="not val_order"/>
                        <field name="create_invoice"/>
                        <field name="val_invoice" invisible="create_invoice == False"/>
                        <field name="register_payment" invisible='not val_invoice'/>
                        <field name="send_invoice_by_email" invisible="not val_invoice"/>
                    </group>
                    <group>
                        <field name="sh_sale_journal"/>
                        <field name="payment_journal" invisible="not register_payment"/>
                        <field name="payment_method" invisible="not create_invoice"/>
                        <field name="company_id"/>
                    </group>
                    </group>
                </sheet>
                
            </form>
        </field>
    </record>
    <record id="sh_auto_sale_workflow_action_view" model="ir.actions.act_window">
        <field name="name">Auto Sale Workflow</field>
        <field name="res_model">sh.auto.sale.workflow</field>
        <field name="view_mode">list,form</field>

    </record>
</odoo>