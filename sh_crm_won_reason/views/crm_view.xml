<odoo>
    <data>
        <record id="sh_crm_won_reason_crm_view_form" model="ir.ui.view">
            <field name="name">sh.crm.won.reason.crm.view.form</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                

                <xpath expr="//field[@name='probability']" position="after">
                   
                   <button string="Wonnnn" type="action" class="oe_highlight"  />
                   
                </xpath>                


                <!-- <xpath expr="//header//button[@name='action_set_won_rainbowman']" position="attributes">
                   
                   <attribute name="invisible">1</attribute>
                   
                </xpath> -->

                <xpath expr="//field[@name='lost_reason_id']" position="after">   
                   <field name="won_reason_id"></field>
                </xpath>
            </field>
        </record>


        <record id="sh_crm_won_reason_crm_view_tree" model="ir.ui.view">
            <field name="name">sh.crm.won.reason.crm.view.tree</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
            <field name="arch" type="xml">
               <xpath expr="//field[@name='lost_reason_id']" position="after">   
                   <field name="won_reason_id" optional="hide"></field>
                </xpath>
            </field>
        </record>
       <menuitem name="Won Reason" id="sh_crm_won_reasonnn_id" action="crm_won_reason_action" parent="crm.crm_menu_config" />
       
    </data>
</odoo>