<odoo>
    <record id="sh_calendar_setting_fields_view_form" model="ir.ui.view">
        <field name="name">sh.calendar.setting.fields.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="calendar.res_config_settings_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//setting[@id='sync_google_calendar_setting']" position="after">
                <setting string="Create Timesheet" id="timesheet_calendar_setting">
                    <field name="group_create_timesheet" />
                    <p class="o_setting_right">
                        Automatically Create timesheet directly from calendar meeting
                    </p>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>