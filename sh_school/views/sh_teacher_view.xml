<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="sh_teacher_list_view" model="ir.ui.view">
        <field name="name">Teacher</field>
        <field name="model">sh.teacher</field>
        <field name="arch" type="xml">
            <list string="Teacher">
                <field name="name"></field>
                <!-- <field name="count"></field> -->
                
            </list>
        </field>
    </record>

    <record id="sh_teacher_form_view" model="ir.ui.view">
        <field name="name">Teacher</field>
        <field name="model">sh.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="class_ids"/>
                        <field name="count" readonly="1"/>
                        <!-- <field name="amount"></field> -->
                    </group>

                    <group string="Basic Teacher Details">
                        <field name="total"/>
                        <field name="amount"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="dob"/>
                        <field name="gender"/>
                        <field name="address"/>
                        <field name="hire_date"/>
                        <field name="department"/>
                        <field name="status"/>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_teacher_action" model="ir.actions.act_window">
        <field name="name">Teacher</field>
        <field name="res_model">sh.teacher</field>
        <field name="view_mode">list,form</field>
    </record>    

</odoo>