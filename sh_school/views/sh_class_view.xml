<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="sh_class_list_view" model="ir.ui.view">
        <field name="name">Class</field>
        <field name="model">sh.class</field>
        <field name="arch" type="xml">
            <list string="Class">
                <field name="name"></field>
                
            </list>
        </field>
    </record>

    <record id="sh_class_form_view" model="ir.ui.view">
        <field name="name">Class</field>
        <field name="model">sh.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <sheet>
                    <div class="d-flex justify-content-between align-item-center">
                        <h1>
                            <field name="name" placeholder="Class Name"></field>
                        </h1>

                    </div>
                    
                    <group>
                        <field name="clsline_ids">
                            <list editable='bottom'>
                                <field name='stud_id'/>
                            </list>
                        </field>
                        <!-- <field name="stu_ids"></field> -->
                    </group>
                    <group>
                        <field name="teacher_id" />
                    </group>
                    <group><field name="countstu"></field></group>
                    <group string="Basic Class Details">
                        <field name="name" />
                        <field name="instructor_name" />
                        <field name="description" />
                        <field name="start_date" />
                        <field name="end_date" />
                        <field name="schedule" />
                        <field name="room_num" />
                        <field name="status" />
                        <field name="class_type" />
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_class_action" model="ir.actions.act_window">
        <field name="name">Class</field>
        <field name="res_model">sh.class</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>