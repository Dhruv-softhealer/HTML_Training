<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="sh_student_list_view" model="ir.ui.view">
        <field name="name">Student</field>
        <field name="model">sh.student</field>
        <field name="arch" type="xml">
            <list string="Student">
                <field name="name"></field>
                <field name="birthdate" widget="remaining_days"></field>
            </list>
        </field>
    </record>

    <record id="sh_student_form_view" model="ir.ui.view">
        <field name="name">Student</field>
        <field name="model">sh.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <div class="d-flex justify-content-between align-item-center">
                        <h1>
                            <field name="name" placeholder="Student Name" widget="char_emojis"></field>
                        </h1>
                        <field name="image" widget="image" class="oe_avatar" />
                        <group>
                            <field name="class_id" />
                        </group>

                    </div>
                    <group><field name="tname" /></group>
                    <group string="Basic Student Details">
                        <group>
                            <field name="age" />
                            <field name="age_type" />
                            <field name="birthdate" />
                            <field name="enr_no" />
                            <field name="gender" />
                            <field name="year_of_enroll" />
                            <field name="dist_from_school_in_m"></field>
                            <field name="dist_from_school_in_km"></field>
                            <field name="stu_name"></field>
                            <field name="stu"></field>
                            <field name="tz"></field>
                        </group>
                        <group>
                            <field name="email" widget="CopyClipboardChar" />
                            <field name="phone" />
                            <field name="city" />
                            <field name="postal" />
                            <field name="state" />
                            <field name="country" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Academic Details">
                            <group string="Details">
                                <field name="grade" />
                                <field name="section" />
                                <field name="roll_no" />
                                <field name="clg_name" />
                                <field name="previous_school" />
                            </group>
                        </page>
                        <page string="Parents Details">
                            <group string="Details">
                                <field name="father_name" />
                                <field name="mother_name" />
                                <field name="parent_phone" />
                                <field name="parent_email" />
                                <field name="emg_phone" />
                            </group>
                        </page>
                        <page string="Additional Details">
                            <group string="Details">
                                <field name="nationality" />
                                <field name="blood" />
                                <field name="transport" />
                                <field name="date_of_admission" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="sh_student_action" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">sh.student</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>