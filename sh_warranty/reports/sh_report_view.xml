<odoo>
    <data>

        <template id="warranty_report_template">
            <t t-call="web.html_container">
                <div class="page">
                    <h1>Warranty Report</h1>
                    <t t-foreach="docs" t-as="order">
                        <p>Customer: <span t-esc="order.name" /></p>
                        <p>Total: <span t-esc="order.warranty_period" /> €</p>
                    </t>
                </div>
            </t>
        </template>
        <record id="sh_action_report_saleorder_raw" model="ir.actions.report">
            <field name="name">Print Quote</field>
            <field name="model">sh.sale.warranty</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sh_warranty.warranty_report_template</field>
            <field name="report_file">sh_warranty.warranty_report_template</field>
            <field name="print_report_name">'Warranty'</field>
            <field name="binding_model_id" ref="sh_warranty.model_sh_sale_warranty" />
            <field name="binding_type">report</field>
        </record>


    </data>
</odoo>