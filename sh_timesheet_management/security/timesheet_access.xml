<odoo>
    <record id="timesheet_category" model="ir.module.category">
        <field name="name">Timesheet</field>
    </record>


    <record id="timesheet_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="sh_timesheet_management.timesheet_category" />
        <field name="comment">The user will be able to join support channels.</field>
    </record>


    <record id="timesheet_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="sh_timesheet_management.timesheet_category" />
        <field name="comment">The user will be able to join support channels.</field>
        <field name="implied_ids" eval="[(4,ref('timesheet_group_user'))]"></field>
    </record>


    <!-- <record id="crm.access_crm_lead" model="ir.model.access">
        <field name="perm_write">0</field>
    </record> -->

    <!-- <record id="crm.access_crm_stage" model="ir.model.access">
        <field name="perm_create">1</field>
    </record> -->


    <!-- =====================RECORD RULES==================== -->


    <record id="timesheet_rule_user" model="ir.rule">
        <field name="name">User can't interact with all the records</field>
        <field name="model_id" ref="model_sh_timesheet" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sh_timesheet_management.timesheet_group_user'))]" />
    </record>


    <record id="timesheet_rule_manager" model="ir.rule">
        <field name="name">Manager can interact with all the records</field>
        <field name="model_id" ref="model_sh_timesheet" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sh_timesheet_management.timesheet_group_manager'))]" />
    </record>


    <!-- ====================== SEQUENCE ======================= -->

    <record id="seq_timesheet" model="ir.sequence">
        <field name="name">Timesheet</field>
        <field name="code">sh.timesheet</field>
        <field name="prefix">T</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>