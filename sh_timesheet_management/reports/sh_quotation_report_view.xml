        <template id="timesheet_report_template">
        <t t-call="web.html_container">
            <div class="page">
                <h2>Title</h2>
                <div class="" style="display: flex; justify-content: space-between;display: -webkit-box !important; display: -webkit-flex !important;">
                    <div class="p-3 border border-black">123</div>
                    <div class="p-3 border border-black">456</div>
                </div>
                <table class="table table-condensed sh_student_table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Age</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- <t t-set="all_students" t-value="doc.get_students()"/> -->
                        <tr t-foreach="all_students" t-as="student">
                            <t t-set="stud" t-value="student.name + 'SSS'"/>
                            <td>

                                <span t-field="student.name"/>
                                <span t-esc="stud"/>
                                <!-- <span t-field="student"/> -->
                            </td>
                            <td>
                                <span t-field="student.age"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>



        <record id="paperformat_timesheet_certification" model="report.paperformat">
            <field name="name">Timesheet Certification</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="disable_shrinking" eval="True"/>
            <field name="dpi">86</field>
        </record>

        <record id="sh_timesheet_report_template_wizard" model="ir.actions.report">
            <field name="name">Timesheet</field>
            <field name="model">sh.timesheet</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sh_timesheet_management.timesheet_report_template</field>
            <field name="report_file">sh_timesheet_management.timesheet_report_template</field>
            <field name="print_report_name">'Timesheets'</field>
            <field name="binding_model_id" ref="sh_timesheet_management.model_sh_timesheet" />
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_timesheet_certification"/>
        </record>

        <!-- <menuitem id="sh_wizard_menu_action"
            name="Timesheet Report"
            action="sh_timesheet_report_template_wizard"
        /> -->
    </data>
</odoo>
