<odoo>
    <record id="sh_task_list_view" model="ir.ui.view">
        <field name="name">sh_task</field>
        <field name="model">sh.task</field>
        <field name="arch" type="xml">
            <list string="Task">
                <field name="name"></field>
            </list>
        </field>
    </record>


    <record id='sh_task_form_view' model='ir.ui.view'>
        <field name='name'>sh_task</field>
        <field name='model'>sh.task</field>
        <field name='arch' type='xml'>
            <form string="Task">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(sh_tag_action_form_view)d" type="action" class="oe_stat_button"
                            icon="fa-pencil-square-o">
                            <!-- <field name="name" /> -->
                            With Action type
                        </button>
                    </div>
                    <group>
                        <field name='name'></field>
                        <field name='amount'></field>
                        <field name='timesheet_id'></field>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id='sh_task_action_view' model='ir.actions.act_window'>
        <field name="name">Task</field>
        <field name="res_model">sh.task</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>