<odoo>
    <record id="sh_tag_list_view" model="ir.ui.view">
        <field name="name">sh_tag</field>
        <field name="model">sh.tag</field>
        <field name="arch" type="xml">
            <list string="Tag">
                <field name="name"></field>
            </list>
        </field>
    </record>


    <record id='sh_tag_form_view' model='ir.ui.view'>
        <field name='name'>sh_tag</field>
        <field name='model'>sh.tag</field>
        <field name='arch' type='xml'>
            <form string="Tag">
                <group>
                    <field name='name'></field>
                </group>
            </form>
        </field>
    </record>


    <record id='sh_tag_action_view' model='ir.actions.act_window'>
        <field name="name">Tag</field>
        <field name="res_model">sh.tag</field>
        <field name="view_mode">list,form</field>
    </record>


<!-- action form view for action button -->


    <record id='sh_tag_action_form_view' model='ir.actions.act_window'>
        <field name="name">Tag</field>
        <field name="res_model">sh.tag</field>
        <field name="view_mode">form</field>
    </record>
</odoo>