<odoo>

<!-- ============================ LIST VIEW ============================= -->

    <record id="sh_timesheet_list_view" model="ir.ui.view">
        <field name="name">sh_timesheet</field>
        <field name="model">sh.timesheet</field>
        <field name="arch" type="xml">
            <list string="Timesheet">
                <field name="name"></field>
                <field name="seq_num"></field>
                <field name='user_id'></field>
                <field name="state" widget="badge"></field>
                <field name="total_amount"></field>
            </list>
        </field>
    </record>

<!-- ============================ FORM VIEW ============================= -->

    <record id='sh_timesheet_form_view' model='ir.ui.view'>
        <field name='name'>sh_timesheet</field>
        <field name='model'>sh.timesheet</field>
        <field name='arch' type='xml'>
            <form string="Timesheet">
                <header>
                    <button name="action_to_move_submitted"
                        string="Submit to Manager" type="object" data-hotkey="g" class="btn-primary"
                        invisible="state != 'draft'" />
                    <button name="action_to_move_approve"
                        groups="sh_timesheet_management.timesheet_group_manager"
                        string="Approve" type="object" class="btn-primary"
                        invisible="state != 'submitted'" />
                    <button name="action_to_open_wizard"
                        groups="sh_timesheet_management.timesheet_group_manager"
                        string="Reject" type="object" class="btn-primary"
                        invisible="state != 'submitted'" />

                    <field name='state' widget="statusbar" statusbar_visible='draft,submitted'></field>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button"
                            icon="fa-pencil-square-o">
                            <field name="name" />
                        </button>
                    </div>

                    <group>
                        <field name='seq_num'></field>
                        <field name='name'></field>
                        <field name='user_id'></field>
                        <field name='description'></field>
                        <field name='rejection_reason'></field>
                        <field name='date' optional="hide"></field>
                        <field name='hours' widget='float_time'></field>
                        <field name='tag_ids' widget="many2many_tags"></field>
                        <field name='rejection_reason' invisible="state != 'reject'"></field>
                        <field name='task_ids' widget="many2many_tags"></field>
                        <field name='total_amount'></field>
                        <field name="date_begin" />
                        <field name="date_end" />
                    </group>

                </sheet>

                <chatter reload_on_post="True"></chatter>
            </form>
        </field>
    </record>

<!-- ============================ KANBAN VIEW ============================= -->

    <record id="timesheet_kanban_view" model="ir.ui.view">
        <field name="name">timesheet.kanban.view</field>
        <field name="model">sh.timesheet</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <!-- <field name="seq_num"></field>
                <field name="name"></field>
                <field name='user_id'></field>
                <field name="state" widget="badge"></field>
                <field name="total_amount"></field> -->
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <field class="fw-bolder" name="seq_num" />
                            </div>
                            <div class="col-4 text-end">
                                <field name="state" widget="badge"></field>
                            </div>

                            <div class="col-8">
                                <field class="fw-bolder" name="name" />
                            </div>
                            <div class="col-4 text-end">
                                <field name="date" invisible="state == 'reject'" />
                            </div>
                        </div>
                        <div>
                            <strong>Total Amount : </strong>
                            <field name="total_amount" />
                        </div>

                    </t>
                </templates>
            </kanban>
        </field>
    </record>

<!-- ============================ PIVOT VIEW ============================= -->

    <record id="timesheet_pivot_view" model="ir.ui.view">
        <field name="name">timesheet.pivot</field>
        <field name="model">sh.timesheet</field>
        <field name="arch" type="xml">
            <pivot string="Timesheet Pivot" sample="1">
                <field name="seq_num" type="col" />
                <field name="state" type="row" />
                <field name="hours" type="measure" />
            </pivot>
        </field>
    </record>

<!-- ============================ CALENDAR VIEW ============================= -->

    <record model="ir.ui.view" id="timesheet_calendar_view">
        <field name="name">timesheet.calendar</field>
        <field name="model">sh.timesheet</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <calendar
                event_open_popup="true"
                quick_create="0"
                date_start="date_begin"
                date_stop="date_end"
                string="Event Organization"
                mode="month"
                event_limit="2">
                <field name="seq_num" />
                <field name="name" />
                <field name="hours" />
                <field name="total_amount" />
                <field name="date_begin" />
                <field name="date_end" />
            </calendar>
        </field>
    </record>


<!-- ============================ TIMESHEET REJECTION FORM VIEW ============================= -->

    <record id="sh_timesheet_rejection_form_view" model="ir.ui.view">
        <field name="name">sh_timesheet_rejection</field>
        <field name="model">sh.timesheet.rejection</field>
        <field name="arch" type="xml">
            <form string="Timesheet Rejection">
                <sheet>
                    <group>
                        <field name="name"></field>
                        <field name="timesheet_id"></field>
                    </group>
                    <footer>
                        <button name='submit_reason' type='object' string='Submit'></button>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

<!-- ============================ TIMESHEET ACTION VIEW ============================= -->

    <record id='sh_timesheet_action_view' model='ir.actions.act_window'>
        <field name="name">Timesheet</field>
        <field name="res_model">sh.timesheet</field>
        <field name="view_mode">list,form,kanban,pivot,calendar</field>
    </record>
</odoo>