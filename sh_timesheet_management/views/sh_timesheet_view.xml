<odoo>
    <record id="sh_timesheet_list_view" model="ir.ui.view">
        <field name="name">sh_timesheet</field>
        <field name="model">sh.timesheet</field>
        <field name="arch" type="xml">
            <list string="Timesheet">
                <field name="name"></field>
                <field name="state" widget="badge"></field>
            </list>
        </field>
    </record>


    <record id='sh_timesheet_form_view' model='ir.ui.view'>
        <field name='name'>sh_timesheet</field>
        <field name='model'>sh.timesheet</field>
        <field name='arch' type='xml'>
            <form string="Timesheet">
                <header>
                    <button name="action_to_move_submitted"
                        string="Submit to Manager" type="object" data-hotkey="g" class="btn-primary"
                        invisible="state != 'draft'" />
                    <button name="action_to_move_approve"
                        string="Approve" type="object" class="btn-primary"
                        invisible="state != 'submitted'" />
                    <button name="action_to_open_wizard"
                        string="Reject" type="object" class="btn-primary"
                        invisible="state != 'submitted'" />

                    <field name='state' widget="statusbar" statusbar_visible='draft,submitted'></field>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button"
                            icon="fa-pencil-square-o">
                            <field name="name" />
                        </button>
                    </div>

                    <group>
                        <field name='user_id'></field>
                        <field name='name'></field>
                        <field name='description'></field>
                        <field name='rejection_reason'></field>
                        <field name='date'></field>
                        <field name='hours' widget='float_time'></field>
                        <field name='tag_ids' widget="many2many_tags"></field>
                        <field name='rejection_reason' invisible="state != 'reject'"></field>
                        <field name='task_ids' widget="many2many_tags"></field>
                        <field name='total_amount'></field>
                    </group>

                </sheet>

                <chatter reload_on_post="True"></chatter>
            </form>
        </field>
    </record>


    <record id="sh_timesheet_rejection_form_view" model="ir.ui.view">
        <field name="name">sh_timesheet_rejection</field>
        <field name="model">sh.timesheet.rejection</field>
        <field name="arch" type="xml">
            <form string="Timesheet Rejection">
                <sheet>
                    <group>
                        <field name="name"></field>
                        <field name="timesheet_id"></field>
                    </group>
                    <footer>
                        <button name='submit_reason' type='object' string='Submit'></button>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id='sh_timesheet_action_view' model='ir.actions.act_window'>
        <field name="name">Timesheet</field>
        <field name="res_model">sh.timesheet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>