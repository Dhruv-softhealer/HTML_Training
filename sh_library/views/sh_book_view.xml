<odoo>
    <record id="sh_book_list_view" model="ir.ui.view">
        <field name="name">Book</field>
        <field name="model">sh.book</field>
        <field name="arch" type="xml">
            <list string="Book">
                <field name="name"></field>
            </list>
        </field>
    </record>

    <record id="sh_doctor_form_view" model="ir.ui.view">
        <field name="name">Book</field>
        <field name="model">sh.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="category_id" />
                        <!-- <field name='b_line_ids'/> -->
                    </group>
                    
                    <group>

                        <field name="authorname" />
                        <field name="pub_date" />
                        <field name="isbn" />
                        <field name="language" />
                        <field name="pages" />
                        <field name="price" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_book_action" model="ir.actions.act_window">
        <field name="name">Book</field>
        <field name="res_model">sh.book</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>