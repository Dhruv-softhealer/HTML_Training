<odoo>
    <record id="sh_category_list_view" model="ir.ui.view">
        <field name="name">Category</field>
        <field name="model">sh.category</field>
        <field name="arch" type="xml">
            <list string="Category">
                <field name="name"></field>
            </list>
        </field>
    </record>

    <record id="sh_category_form_view" model="ir.ui.view">
        <field name="name">Category</field>
        <field name="model">sh.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="count" />
                        </group>
                    </group>

                    <group>
                        <field name="c_line_ids">
                            <list editable='bottom'>
                                <field name="b_line_id" />
                            </list>
                        </field>
                    </group>
                    <group>

                        <field name="description" />
                        <field name="type" />
                        <!-- <field name="book_ids"> -->
                            <!-- <list editable='bottom'>
                                <field name="category_id"/>
                            </list> -->
                        <!-- </field> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_category_action" model="ir.actions.act_window">
        <field name="name">Category</field>
        <field name="res_model">sh.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>