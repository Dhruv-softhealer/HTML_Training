<odoo>
    <record id="sh_member_list_view" model="ir.ui.view">
        <field name="name">Member</field>
        <field name="model">sh.member</field>
        <field name="arch" type="xml">
            <list string="Member">
                <field name="name"></field>
                <field name="membership_type"/>
            </list>
        </field>
    </record>

    <record id="sh_member_form_view" model="ir.ui.view">
        <field name="name">Member</field>
        <field name="model">sh.member</field>
        <field name="arch" type="xml">
            <form string="Member">
                <sheet>
                    <group> 
                        <field name="name"/>
                        <field name="contact"/>
                        <field name="email"/>
                        <field name="bk_ids" widget="many2many_tags" />
                        <field name="membership_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_member_action" model="ir.actions.act_window">
        <field name="name">Member</field>
        <field name="res_model">sh.member</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>