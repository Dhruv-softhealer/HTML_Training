<odoo>

    <record id="sh_employee_category_list_view" model="ir.ui.view">
        <field name='name'>sh.employee.category.list.view</field>
        <field name="model">sh.employee.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name" />
                <field name="color" />
            </list>
        </field>
    </record>   
    
    <record id="sh_employee_category_form_view" model="ir.ui.view">
        <field name='name'>sh.employee.category.form.view</field>
        <field name="model">sh.employee.category</field>
        <field name="arch" type="xml">
            <form string="Category Details">
                <group>
                    <field name="name" />
                    <field name="active" />
                    <field name="color" />
                </group>
                <group string="Many to Many fields">
                    <field name="employee_ids" />
                </group>
            </form>
        </field>
    </record>    
    
    <record id="sh_employee_category_action" model="ir.actions.act_window">
        <field name='name'>Employee Category</field>
        <field name="res_model">sh.employee.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>