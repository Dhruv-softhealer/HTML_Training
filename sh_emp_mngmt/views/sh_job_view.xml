<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="sh_job_list_view" model="ir.ui.view">
        <field name="name">Job</field>
        <field name="model">sh.job</field>
        <field name="arch" type="xml">
            <list string="Job">
                <field name="name"></field>
            </list>
        </field>
    </record>

    <record id="sh_job_form_view" model="ir.ui.view">
        <field name="name">Job</field>
        <field name="model">sh.job</field>
        <field name="arch" type="xml">
            <form string="Job">
                <sheet>

                    <group>
                        <group>
                            <field name="name" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="manager_id" />
                            <field name="address_id" />
                        </group>
                        <group>
                            <field name="favorite_user_ids" />
                            <field name="interviewer_ids" />
                            <field name="extended_interviewer_ids" />
                        </group>
                        <group>
                            <field name="emp_ids">

                                <form>
                                    <group>
                                        <field name="name" />
                                    </group>
                                </form>

                            </field>

                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_job_action" model="ir.actions.act_window">
        <field name="name">Job</field>
        <field name="res_model">sh.job</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>