<odoo>
    <record id="sh_helpdesk_create_task_view_form" model="ir.ui.view">
        <field name="name">sh.helpdesk.helpdesk.create.task.view.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <header>
                <xpath expr="//button[@name='action_open_helpdesk_ticket']" position="after">
                    <button name="create_helpdesk_task" string="Create Task" type="object" class="btn btn-secondary">
                    </button>
                </xpath>
            </header>
        </field>
    </record>
</odoo>