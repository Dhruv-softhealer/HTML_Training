<odoo>
    <data noupdate="1">
        <record id="sh_appointment_cron_job" model="ir.cron">
            <field name="name">Move Appointments to Today</field>
            <field name="model_id" ref="model_sh_appointment" />
            <field name="state">code</field>
            <field name="code">model.move_to_today_appointment()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>