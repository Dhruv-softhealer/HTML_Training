<odoo>
    <record id="sh_appointment_list_view" model="ir.ui.view">
        <field name="name">Appointment</field>
        <field name="model">sh.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointment">
                <field name="name"></field>
                <field name="sh_patient_id"></field>
                <field name="sh_doctor_id"></field>
                <field name="sh_date"></field>
                <field name="sh_state" widget="badge"
                    decoration-success="sh_state == 'completed_appointment'"
                    decoration-danger="sh_state == 'cancelled_appointment'"
                    decoration-warning="sh_state == 'pending'"
                    decoration-info="sh_state == 'today_apt'"
                    decoration-primary="sh_state == 'in_progress'"
                    decoration-muted="sh_state == 'new'">
                </field>
            </list>
        </field>
    </record>

    <record id="sh_appointment_form_view" model="ir.ui.view">
        <field name="name">Appointment</field>
        <field name="model">sh.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">

                <header>
                    <button name="check_in" type="object" string="Check-in" class="oe_highlight"
                        invisible="sh_state == 'completed_appointment' or sh_state == 'cancelled_appointment' or sh_state != 'today_apt' or sh_state == 'in_progress'" />

                    <button name="pending_appointment" type="object" string="Pending"
                        class="oe_highlight"
                        invisible="sh_state == 'completed_appointment' or sh_state == 'cancelled_appointment' or sh_state != 'today_apt' or sh_state == 'pending'" />

                    <button name="move_to_done" type="object" string="Done" class="oe_highlight"
                        invisible="sh_state == 'completed_appointment' or sh_state == 'cancelled_appointment' " />

                    <button name="unlock_record" type="object" string="Unlock Appointment"
                        class="btn btn-success"
                        invisible="sh_state == 'cancelled_appointment' or sh_state != 'completed_appointment'" />

                    <button name="cancel_record" type="object" string="Cancel"
                        class="btn btn-danger"
                        invisible="sh_state == 'completed_appointment' or sh_state == 'cancelled_appointment'" />

                    <field name="sh_state" widget="statusbar"></field>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object"
                            class="oe_stat_button" icon="fa-stethoscope"
                            context="{'sh_patient_id': sh_patient_id}"
                            invisible="not apt_count">
                            <div class="o_stat_info">
                                <field name="apt_count" string="Appointments" class="o_stat_value"
                                    invisible="not apt_count" />Appointments </div>
                        </button>
                        <button type="object"
                            name="action_view_sales_order"
                            icon="fa-file-text-o"
                            groups="sh_clinic_mgmt.clinic_group_admin"
                            class="oe_stat_button"
                            invisible="not sale_order_id">
                            <field name="sale_order_id" invisible="1" />
                            <div class="o_stat_info">
                                <span>Sales Order</span>
                            </div>
                        </button>
                    </div>
                    <h1>
                        <field name="name"></field>
                    </h1>
                    <group>
                        <group>
                            <field name="sh_expected_revenue"
                                readonly="sh_state == 'completed_appointment'"></field>
                            <field name="sh_doctor_domain_ids" invisible="1"></field>
                            <field name="sh_company_id" invisible="1"></field>
                            <field name="sh_patient_id"
                                readonly="sh_state == 'completed_appointment'"></field>
                            <field name="sh_age"></field>
                            <field name="sh_doctor_id"
                                readonly="sh_state == 'completed_appointment'"></field>
                            <field name="sh_doctor_specialization"></field>
                        </group>
                        <group>
                            <field name="sh_emergency_case"
                                readonly="sh_state == 'completed_appointment'"></field>
                            <field name="sh_date" readonly="sh_state == 'completed_appointment'"></field>
                            <field name="sh_slt_id" readonly="sh_state == 'completed_appointment'"
                                options="{'no_create': True}"></field>
                        </group>
                    </group>
                    <notebook>
                        <page string="Patient Details">
                            <group>
                                <field name="sh_last_visited" readonly="0"></field>
                                <field name="sh_visit_type"
                                    readonly="sh_state == 'completed_appointment'"></field>
                                <field name="sh_blood_group" readonly="0"></field>
                            </group>
                            <group>
                                <field name="sh_email" readonly="0"></field>
                                <field name="sh_phone"
                                    readonly="sh_state == 'completed_appointment'"></field>
                                <field name="sh_birth_date" readonly="0"></field>
                                <field name="sh_age" readonly="0"></field>
                            </group>
                        </page>
                        <page string="Disease Details">
                            <field name="sh_disease_line">
                                <list>
                                    <field name="sh_disease_id"></field>
                                    <field name="sh_disease_category"></field>
                                    <field name="sh_symptoms_ids"></field>
                                    <field name="sh_severity"></field>
                                    <field name="description"></field>
                                </list>
                            </field>
                        </page>
                        <page string="Prescription &amp; Medication">
                            <field name="sh_prescription_line">
                                <list>
                                    <field name="sh_medicine_id"></field>
                                    <field name="sh_medicine_type_id"></field>
                                    <field name="sh_dosage_duration"></field>
                                    <field name="sh_instruction"></field>
                                    <field name="sh_advice"></field>
                                    <field name="sh_morning"></field>
                                    <field name="sh_afternoon"></field>
                                    <field name="sh_evening"></field>
                                    <field name="sh_night"></field>
                                </list>
                            </field>
                        </page>
                        <page string="Personal Medical Info">
                            <group>
                                <group>
                                    <field name="sh_dietary_preferences"></field>
                                    <field name="sh_lifestyle_factors_ids" widget="many2many_tags"></field>
                                    <field name="sh_mental_health_issues_ids"
                                        widget="many2many_tags"></field>
                                </group>
                                <group>
                                    <field name="sh_chronic_conditions_ids" widget="many2many_tags"></field>
                                    <field name="sh_allergy_ids" widget="many2many_tags"></field>
                                </group>
                            </group>
                        </page>
                        <page string="Emergency" invisible="not sh_emergency_case">
                            <group>
                                <group>
                                    <field name="sh_priority_level"
                                        readonly="sh_state == 'completed_appointment'"></field>
                                    <field name="sh_doctor_notified"
                                        readonly="sh_state == 'completed_appointment'"></field>
                                    <field name="sh_assigned_doctor"
                                        readonly="sh_state == 'completed_appointment'"></field>
                                </group>
                                <group>
                                    <field name="sh_immediate_check_in"
                                        readonly="sh_state == 'completed_appointment'"></field>
                                    <field name="sh_emergency_slot_bypass"
                                        readonly="sh_state == 'completed_appointment'"></field>
                                    <field name="sh_walk_in_case"
                                        readonly="sh_state == 'completed_appointment'"></field>
                                    <field name="sh_checked_in"
                                        readonly="sh_state == 'completed_appointment'"
                                    ></field>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->

                <chatter />
            </form>
        </field>
    </record>

    <record id="sh_appointment_search_view_page" model="ir.ui.view">
        <field name="name">sh.appointment.search</field>
        <field name="model">sh.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointment">

                <!-- Basic Search Field -->

                <field name="name" string="Appointment Number" />
                <field name="sh_patient_id" string="Patient" />
                <field name="sh_doctor_id" string="Doctor" />

                <!-- Filter Section -->

                <filter string="New Visits" name="new_visits"
                    domain="[('sh_visit_type', '=', 'new')]" />
                <filter string="Old Visits" name="old_visits"
                    domain="[('sh_visit_type', '=', 'old')]" />
                <filter string="Emergency Cases" name="emergency_cases"
                    domain="[('sh_emergency_case', '=', True)]" />
                <filter string="Walk-In Cases" name="walkin_cases"
                    domain="[('sh_walk_in_case', '=', True)]" />
                <filter string="Checked-In" name="checked_in"
                    domain="[('sh_checked_in', '=', True)]" />
                <filter string="Doctor Notified" name="doctor_notified"
                    domain="[('sh_doctor_notified', '=', True)]" />
                <separator />

                <filter string="Priority: High" name="priority_high"
                    domain="[('sh_priority_level', '=', 'high')]" />
                <filter string="Priority: Critical" name="priority_critical"
                    domain="[('sh_priority_level', '=', 'critical')]" />
                <separator />

                <filter string="State: New" name="state_new" domain="[('sh_state', '=', 'new')]" />
                <filter string="State: In Progress" name="state_in_progress"
                    domain="[('sh_state', '=', 'in_progress')]" />
                <filter string="State: Completed" name="state_completed"
                    domain="[('sh_state', '=', 'completed_appointment')]" />
                <filter string="State: Cancelled" name="state_cancelled"
                    domain="[('sh_state', '=', 'cancelled_appointment')]" />
                <separator />

                <!-- Group By -->

                <group expand="0" string="Group By">
                    <filter string="Doctor" name="group_by_doctor"
                        context="{'group_by': 'sh_doctor_id'}" />
                    <filter string="Visit Type" name="group_by_visit_type"
                        context="{'group_by': 'sh_visit_type'}" />
                    <filter string="Priority" name="group_by_priority"
                        context="{'group_by': 'sh_priority_level'}" />
                    <filter string="State" name="group_by_state" context="{'group_by': 'sh_state'}" />
                    <filter string="Date" name="group_by_date" context="{'group_by': 'sh_date'}" />
                </group>
            </search>
        </field>
    </record>


    <record id="sh_appointment_action_view" model="ir.actions.act_window">
        <field name="name">Appointment</field>
        <field name="res_model">sh.appointment</field>
        <field name="view_mode">list,form,search</field>
    </record>

    <!-- Mass Section to move the state of all selected record  -->
    <record id="action_mass_publish_state" model="ir.actions.server">
        <field name="name">Move Stage</field>
        <field name="model_id" ref="sh_clinic_mgmt.model_sh_appointment" />
        <field name="binding_model_id" ref="sh_clinic_mgmt.model_sh_appointment" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_change_stage()</field>
    </record>

</odoo>