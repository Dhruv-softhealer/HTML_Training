<odoo>
    <record id="view_sh_appointment_stage_wizard_form" model="ir.ui.view">
        <field name="name">sh.appointment.stage.wizard.form</field>
        <field name="model">sh.appointment.stage.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Appointment Stage">
                <group>
                    <field name="state" />
                </group>
                <footer>
                    <button string="Change" type="object" name="action_change_stage"
                        class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sh_appointment_stage_wizard" model="ir.actions.act_window">
        <field name="name">Change Appointment Stage</field>
        <field name="res_model">sh.appointment.stage.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sh_appointment_stage_wizard_form" />
        <field name="target">new</field>
    </record>

</odoo>