        <template id="portal_my_home_sale" name="Quotations / Sales Orders" customize_show="True"
            inherit_id="portal.portal_my_home" priority="20">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
                <t t-set="portal_client_category_enable" t-value="True" />
                <t t-set="portal_alert_category_enable" t-value="True" />
            </xpath>
            <div id="portal_alert_category" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="bg_color" t-value="'alert alert-primary align-items-center'" />
                    <t t-set="placeholder_count" t-value="'appointment_count'" />
                    <t t-set="title">See Appointments</t>
                    <t t-set="url" t-value="'/my/appointments'" />
                    <t t-set="show_count" t-value="True" />
                </t>
            </div>
        </template>


        <template id="portal_my_appointments" name="My Appointments">
            <t t-call="portal.portal_layout">
                <t t-set="title">My Appointments</t>

                <div class="container">
                    <div class="o_portal_submenu">
                        <!-- Searchbar Row -->
                        <div class="d-flex justify-content-end mb-2">
                            <form method="get" class="form-inline">
                                <div class="input-group">

                                    <!-- Sort By -->

                                    <div t-if="searchbar_sortings" class="ms-lg-2">
                                        <span class="small me-1 navbar-text">Sort By:</span>
                                        <div class="btn-group">
                                            <button id="portal_searchbar_sortings"
                                                data-bs-toggle="dropdown"
                                                class="btn btn-light dropdown-toggle">
                                                <t
                                                    t-esc="searchbar_sortings.get(sortby, searchbar_sortings.get('default')).get('label', 'Default')" />
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end"
                                                aria-labelledby="portal_searchbar_sortings">
                                                <t t-foreach="searchbar_sortings.items()"
                                                    t-as="s_sort">
                                                    <a
                                                        t-att-href="'/my/appointments?' + keep_query('*', sortby=s_sort[0])"
                                                        t-attf-class="dropdown-item#{sortby == s_sort[0] and ' active' or ''}">
                                                        <t t-esc="s_sort[1]['label']" />
                                                    </a>
                                                </t>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Filter By -->

                                    <div t-if="searchbar_filters" class="ms-lg-2">
                                        <span class="small me-1 navbar-text">Filter By:</span>
                                        <div class="btn-group">
                                            <button id="portal_searchbar_filters"
                                                data-bs-toggle="dropdown"
                                                class="btn btn-light dropdown-toggle">
                                                <t
                                                    t-esc="searchbar_filters.get(filterby, searchbar_filters.get('all')).get('label', 'All')" />
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end"
                                                aria-labelledby="portal_searchbar_filters">
                                                <t t-foreach="searchbar_filters.items()"
                                                    t-as="f_filter">
                                                    <a
                                                        t-att-href="'/my/appointments?' + keep_query('*', filterby=f_filter[0])"
                                                        t-attf-class="dropdown-item#{filterby == f_filter[0] and ' active' or ''}">
                                                        <t t-esc="f_filter[1]['label']" />
                                                    </a>
                                                </t>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Group By -->

                                    <div t-if="searchbar_groupings" class="ms-lg-2">
                                        <span class="small me-1 navbar-text">Group By:</span>
                                        <div class="btn-group">
                                            <button id="portal_searchbar_groupings"
                                                data-bs-toggle="dropdown"
                                                class="btn btn-light dropdown-toggle">
                                                <t
                                                    t-esc="searchbar_groupings.get(groupby, searchbar_groupings.get('None')).get('label', 'None')" />
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end"
                                                aria-labelledby="portal_searchbar_groupings">
                                                <t t-foreach="searchbar_groupings.items()"
                                                    t-as="g_froup">
                                                    <a
                                                        t-att-href="'/my/appointments?' + keep_query('*', search_in=g_froup[0])"
                                                        t-attf-class="dropdown-item#{groupby == g_froup[0] and ' active' or ''}">
                                                        <span
                                                            t-esc="g_froup[1]['label']" />
                                                    </a>
                                                </t>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Search In -->

                                    <div t-if="searchbar_inputs" class="ms-lg-2">
                                        <div class="btn-group">
                                            <button id="portal_searchbar_inputs"
                                                data-bs-toggle="dropdown"
                                                class="btn btn-light dropdown-toggle">
                                                <span class="caret"></span>
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end"
                                                aria-labelledby="portal_searchbar_inputs">
                                                <t t-foreach="searchbar_inputs.items()"
                                                    t-as="s_input">
                                                    <a
                                                        t-att-href="'/my/appointments?' + keep_query('*', search_in=s_input[0])"
                                                        t-attf-class="dropdown-item#{search_in == s_input[0] and ' active' or ''}">
                                                        <t t-esc="s_input[1]['label']" />
                                                    </a>
                                                </t>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Search Input -->
                                    <input type="search"
                                        class="form-control border-0 bg-light"
                                        t-att-placeholder="searchbar_inputs.get(search_in, {}).get('label', '')"
                                        t-att-value="search"
                                        name="search" />
                                    <button class="btn btn-light" type="submit">
                                        <span class="oi oi-search" />
                                    </button>


                                </div>
                            </form>
                        </div>
                    </div>


                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Appointment Number</th>
                                <th>Date</th>
                                <th>Doctor</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="appointments">
                                <t t-foreach="appointments" t-as="appointment">
                                    <tr>
                                        <td>
                                            <a t-att-href="'/my/appointments/%s' % appointment.id">
                                                <t t-esc="appointment.name" />
                                            </a>
                                        </td>
                                        <td>
                                            <t t-esc="appointment.sh_date" />
                                        </td>
                                        <td>
                                            <t t-esc="appointment.sh_doctor_id.name" />
                                        </td>
                                        <td class="text-uppercase">
                                            <span class="badge rounded-pill"
                                                style="background-color: #e6f7fb; color: #007b8f; border: 1px solid #007b8f;">
                                                <t t-esc="appointment.sh_state" />
                                            </span>
                                        </td>

                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="4">No appointments found.</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

            </t>
        </template>

        <!-- Breadcrumb -->

        <template id="portal_breadcrumbs" inherit_id="portal.portal_breadcrumbs">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'appointments'" class="breadcrumb-item">
                    <a t-attf-href="/my/appointments?{{ keep_query() }}">Your Appointments</a>
                </li>
                <li t-if="page_name == 'appointments' and document" class="breadcrumb-item active">
                    <t t-esc="document.name" />
                </li>
            </xpath>
        </template>

        <!-- Detail View -->
        <template id="portal_appointment_detail" name="Appointment Detail">
            <t t-call="portal.portal_layout">

                <div class="text-end my-4">
                    <div class="btn-group bg-light rounded px-2 py-1 shadow-sm">
                        <!-- Previous Button -->
                        <t t-if="prev_id">
                            <a t-attf-href="/my/appointments/{{ prev_id }}"
                                class="btn btn-link text-dark">
                                <i class="fa fa-chevron-left"></i>
                            </a>
                        </t>
                        <t t-else="">
                            <button class="btn btn-link text-muted" t-att-disabled="not prev_id">
                                <i class="fa fa-chevron-left"></i>
                            </button>
                        </t>

                        <!-- Next Button -->
                        <t t-if="next_id">
                            <a t-attf-href="/my/appointments/{{ next_id }}"
                                class="btn btn-link text-dark">
                                <i class="fa fa-chevron-right"></i>
                            </a>
                        </t>
                        <t t-else="">
                            <button class="btn btn-link text-muted" t-att-disabled="not next_id">
                                <i class="fa fa-chevron-right"></i>
                            </button>
                        </t>
                    </div>
                </div>

                <div class="container my-5">
                    <div class="row">
                        <!-- LEFT COLUMN: Doctor & Patient Info -->
                        <div class="col-md-3">
                            <a t-att-href="'/appointment/report/%s' % appointment.id"
                                target="_blank"
                                class="btn btn-outline-dark w-100 my-2">
                                <i class="fa fa-download me-2"></i>Download Report </a>

                            <div class="mb-4">
                                <p class="text-muted fw-bold mb-1">Doctor</p>
                                <div class="d-flex align-items-center mb-2">
                                    <img
                                        t-att-src="appointment.sh_doctor_id.image_128 and '/web/image/res.partner/' + str(appointment.sh_doctor_id.id) + '/image_128'"
                                        class="rounded-circle me-2"
                                        style="width: 36px; height: 36px;"
                                        alt="Doctor Image" />
                                    <span class="fw-bold">
                                        <t t-esc="appointment.sh_doctor_id.name" />
                                    </span>
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa fa-phone me-2 text-dark"></i>
                                    <span>
                                        <t t-esc="appointment.sh_doctor_id.work_phone" />
                                    </span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-envelope me-2 text-dark"></i>
                                    <span>
                                        <t t-esc="appointment.sh_doctor_id.work_email" />
                                    </span>
                                </div>
                            </div>


                            <div class="mb-4">
                                <h6 class="text-muted mb-2">Patient</h6>
                                <div class="d-flex align-items-center mb-2">
                                    <img
                                        t-att-src="appointment.sh_patient_id.image_128 and '/web/image/res.partner/' + str(appointment.sh_patient_id.id) + '/image_128'"
                                        class="rounded-circle me-2" width="32" height="32" />
                                    <span class="fw-bold">
                                        <t t-esc="appointment.sh_patient_id.name" />
                                    </span>
                                </div>
                                <div class="ms-4">
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="fa fa-phone me-2 text-dark"></i>
                                        <span>
                                            <t t-esc="appointment.sh_phone" />
                                        </span>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="fa fa-envelope me-2 text-dark"></i>
                                        <span>
                                            <t t-esc="appointment.sh_email" />
                                        </span>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="fa fa-tint me-2 text-dark"></i>
                                        <span>
                                            <t t-esc="appointment.sh_blood_group" />
                                        </span>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="fa fa-calendar me-2 text-dark"></i>
                                        <span>
                                            <t t-esc="appointment.sh_birth_date" />
                                        </span>
                                    </div>
                                </div>
                            </div>

                        </div>


                        <!-- RIGHT COLUMN: Appointment Details -->
                        <div class="col-md-8">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h3>
                                        <i class="fa fa-star-o text-secondary me-2"></i>
                                        <t t-esc="appointment.name" />
                                    </h3>
                                </div>
                                <div>
                                    <strong>Stage : </strong>
                                    <span
                                        t-attf-class="badge rounded-pill px-3 py-2 bg-light border text-uppercase text-primary">
                                        <t t-esc="appointment.sh_state" />
                                    </span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <p>
                                    <strong>Slot:</strong>
                                    <t t-esc="appointment.sh_slt_id.name" />
                                </p>
                                <p>
                                    <strong>Date:</strong>
                                    <t t-esc="appointment.sh_date" />
                                </p>
                                <p>
                                    <strong>Visit Type:</strong>
                                    <t t-esc="appointment.sh_visit_type" />
                                </p>
                                <p>
                                    <strong>Last Visited:</strong>
                                    <t t-esc="appointment.sh_last_visited" />
                                </p>
                                <p>
                                    <strong>Case Charges:</strong>
                                    <t t-esc="appointment.sh_expected_revenue" />
                                </p>
                            </div>

                            <!-- Optional Table Section -->
                            <div class="mt-5">
                                <h5 class="text-uppercase text-dark mb-3">Summary</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <th>Status</th>
                                        <td>
                                            <t t-esc="appointment.sh_state" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Slot</th>
                                        <td>
                                            <t t-esc="appointment.sh_slt_id.name" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Date</th>
                                        <td>
                                            <t t-esc="appointment.sh_date" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Visit Type</th>
                                        <td>
                                            <t t-esc="appointment.sh_visit_type" />
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </template>
    </data>
</odoo>