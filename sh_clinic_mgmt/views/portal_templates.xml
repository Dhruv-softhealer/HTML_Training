<odoo>
    <data>

        <template id="portal_my_home" inherit_id="portal.portal_my_home">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
                <t t-set="portal_client_category_enable" t-value="True" />
            </xpath>

            <div id="portal_client_category" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/sh_clinic_mgmt/static/img/aptt.png'" />
                    <t t-set="title">Appointments</t>
                    <t t-set="url" t-value="'/my/appointments'" />
                    <!-- <t t-set="show_count" t-value="True" /> -->

                    <t t-set="text">Book Your Appointment</t>
                    <t t-set="placeholder_count" t-value="'appointment_count'" />
                </t>
            </div>
        </template>


        <template id="portal_my_appointments" name="My Appointments">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True" />


                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Appointent</t>
                    <div class="form-inline ml-lg-4 sh_book_btn" id="sh_book_btn">

                        <!-- Book Appointment Button -->

                        <a id="new_appt" class="btn btn-secondary" name="new_appt"
                            title="Create APT Request" aria-label="Create APT Request"
                            role="button">
                            <i class="fa fa-plus" /> Book Appointment </a>
                    </div>
                </t>

                <div id="createticketModal" class="modal fade" role="dialog">
                    <div class="modal-dialog">
                        <!-- Modal content-->
                        <div class="modal-content">

                            <div
                                class="modal-header d-flex justify-content-between align-items-center">
                                <h5 class="modal-title">Book Appointment</h5>
                                <button type="button" class="close" data-bs-dismiss="modal"
                                    aria-label="Close">
                                    <span aria-hidden="true">&amp;times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <!-- Call the form template directly -->
                                <!-- <t t-call="sh_clinic_mgmt.book_appointment_form" /> -->

                                <form action="/submit/appointment" method="post"
                                    class="form o_portal_appointment_form">
                                    <input type="hidden" name="csrf_token"
                                        t-att-value="request.csrf_token()" />

                                    <!-- Doctor -->
                                    <div class="form-group">
                                        <label for="sh_doctor_id">Doctor</label>
                                        <select name="sh_doctor_id" class="form-control"
                                            id="sh_doctor_id">
                                            <t t-foreach="doctors" t-as="doc">
                                                <option t-att-value="doc.id">
                                                    <t t-esc="doc.name" />
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <!-- Appointment Date -->
                                    <div class="row">
                                        <div
                                            class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 com-sm-12 col-xs-12">
                                            <div t-attf-class="form-group mb-3">
                                                <div class="form-group">
                                                    <label for="sh_date">Select Appointment Date</label>
                                                    <input type="date" id="sh_date" name="sh_date"
                                                        class="form-control"
                                                    />
                                                </div>
                                            </div>
                                        </div>
                                        <div
                                            class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 com-sm-12 col-xs-12">
                                            <div t-attf-class="form-group mb-3">
                                                <label class="control-label mb-1"
                                                    for="portal_subcategory">slot</label>
                                                <select
                                                    class="form-control form-field o_website_form_required_custom"
                                                    id="portal_slot" name="portal_slot">
                                                    <option value="sub_category">Select slot</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Phone -->
                                    <div class="form-group">
                                        <label for="sh_phone">Phone</label>
                                        <input type="text" name="sh_phone" class="form-control" />
                                    </div>

                                    <button type="submit" class="btn btn-success mt-2">Submit</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <t t-if="request.session.get('apt_success')">
                    <div class="alert alert-success alert-dismissible fade show w-50" role="alert">
                        <t t-esc="request.session.pop('apt_success')" />
                        <button type="button" class="close" data-bs-dismiss="alert"
                            aria-label="Close">
                            <span aria-hidden="true">&amp;times;</span>
                        </button>
                    </div>
                </t>


                <div t-if="not appointments" class="alert alert-warning" role="alert">
                    There are currently no Transfer for your account.
                </div>


                <t t-if="grouped_tickets" t-call="portal.portal_table">
                    <t t-foreach="grouped_tickets" t-as="group">
                        <table class="table table-hover mb-4">
                            <thead>
                                <tr
                                    t-attf-class="{{'thead-light' if not groupby == 'none' else ''}}">

                                    <th t-if="groupby == 'doctor'">
                                        <em class="font-weight-normal text-muted">Doctor:</em>
                                        <span t-field="group[0].sh_doctor_id.name" />
                                    </th>
                                    <th t-if="groupby == 'date'">
                                        <em class="font-weight-normal text-muted">Date:</em>
                                        <span t-esc="group[0].sh_date" />
                                    </th>
                                    <th t-if="groupby == 'state'">
                                        <em class="font-weight-normal text-muted">Customer:</em>
                                        <span t-esc="group[0].sh_state" />
                                    </th>
                                </tr>
                                <tr class="thread-light">
                                    <th>Appointment Number</th>
                                    <th>Doctor</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>

                            </thead>
                            <tbody>
                                <t t-foreach="group" t-as="g">
                                    <tr>
                                        <td>
                                            <a t-att-href="g.get_portal_url()">
                                                <t t-esc="g.name" />
                                            </a>
                                        </td>
                                        <td>
                                            <span t-field="g.sh_doctor_id.name" />
                                        </td>
                                        <td>
                                            <span t-field="g.sh_date" />
                                        </td>
                                        <td class="text-uppercase">
                                            <span class="badge rounded-pill"
                                                style="background-color: #e6f7fb; color: #007b8f; border: 1px solid #007b8f;">
                                                <t t-esc="g.sh_state" />
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </t>

            </t>
        </template>

        <!-- Breadcrumb -->

        <template id="portal_breadcrumbs" inherit_id="portal.portal_breadcrumbs">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li id="portal_breadcrumbs_appointments" t-if="page_name == 'appointments'"
                    t-attf-class="breadcrumb-item #{'active ' if not appointment else ''}">
                    <a t-if="appointment" t-attf-href="/my/appointments?{{ keep_query() }}">My
                        Appointments</a>
                    <t t-else="">My Appointments</t>
                    <!-- Portal -->
                </li>
                <li t-if="appointment" class="breadcrumb-item active">
                    <span t-field="appointment.name" />
                </li>
            </xpath>
        </template>

        <!-- Detail View -->
        <template id="portal_appointment_detail" name="Appointment Detail">
            <t t-call="portal.portal_layout">
                <div class="container my-5">
                    <div class="row">
                        <!-- LEFT COLUMN: Doctor & Patient Info -->
                        <div class="col-md-3">

                            <!-- Report Download button -->

                            <a class="btn btn-primary o_download_btn flex-grow-1 w-100 my-2"
                                t-att-href="appointment.get_portal_url(report_type='pdf')"
                                title="Download" target='_blank' role="button">
                                <i class="fa fa-download" /> View Detail </a>

                            <a t-att-href="'/my/appointment/delete/%s' % appointment.id"
                                class="btn btn-danger flex-grow-1 w-100 my-2"
                                title="Cancel Appointment" role="button"
                                onclick="return confirm('Are you sure you want to cancel this appointment?');">
                                <i class="fa fa-times-circle" aria-hidden="true" /> Cancel
                                Appointment </a>

                            <t t-if="request.session.get('cancel_error')">
                                <div class="alert alert-danger" role="alert">
                                    <t t-esc="request.session.pop('cancel_error')" />
                                </div>
                            </t>

                            <div class="mb-4">
                                <p class="text-muted fw-bold mb-1">Doctor</p>
                                <div class="d-flex align-items-center mb-2">
                                    <img
                                        t-att-src="appointment.sh_doctor_id.image_128 and '/web/image/res.partner/' + str(appointment.sh_doctor_id.id) + '/image_128'"
                                        class="rounded-circle me-2"
                                        style="width: 36px; height: 36px;"
                                        alt="Doctor Image" />
                                    <span class="fw-bold">
                                        <t t-esc="appointment.sh_doctor_id.name" />
                                    </span>
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa fa-phone me-2 text-dark"></i>
                                    <span>
                                        <t t-esc="appointment.sh_doctor_id.work_phone" />
                                    </span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-envelope me-2 text-dark"></i>
                                    <span>
                                        <t t-esc="appointment.sh_doctor_id.work_email" />
                                    </span>
                                </div>
                            </div>


                            <div class="mb-4">
                                <h6 class="text-muted fw-bold mb-1">Patient</h6>
                                <div class="d-flex align-items-center mb-2">
                                    <img
                                        t-att-src="appointment.sh_patient_id.image_128 and '/web/image/res.partner/' + str(appointment.sh_patient_id.id) + '/image_128'"
                                        class="rounded-circle me-2"
                                        style="width: 36px; height: 36px;"
                                        alt="Patient Image" />
                                    <span class="fw-bold">
                                        <t t-esc="appointment.sh_patient_id.name" />
                                    </span>
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa fa-phone me-2 text-dark"></i>
                                    <span>
                                        <t t-esc="appointment.sh_phone" />
                                    </span>
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa fa-envelope me-2 text-dark"></i>
                                    <span>
                                        <t t-esc="appointment.sh_email" />
                                    </span>
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa fa-tint me-2 text-dark"></i>
                                    <span>
                                        <t t-esc="appointment.sh_blood_group" />
                                    </span>
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa fa-calendar me-2 text-dark"></i>
                                    <span>
                                        <t t-esc="appointment.sh_birth_date" />
                                    </span>
                                </div>
                            </div>

                        </div>


                        <!-- RIGHT COLUMN: Appointment Details -->
                        <div class="col-md-8">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h3>
                                        <i class="fa fa-star-o text-secondary me-2"></i>
                                        <t t-esc="appointment.name" />
                                    </h3>
                                </div>
                                <div>
                                    <strong>Stage : </strong>
                                    <span
                                        t-attf-class="badge rounded-pill px-3 py-2 bg-light border text-uppercase text-primary">
                                        <t t-esc="appointment.sh_state" />
                                    </span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <p>
                                    <strong>Slot:</strong>
                                    <t t-esc="appointment.sh_slt_id.name" />
                                </p>
                                <p>
                                    <strong>Date:</strong>
                                    <t t-esc="appointment.sh_date" />
                                </p>
                                <p>
                                    <strong>Visit Type:</strong>
                                    <t t-esc="appointment.sh_visit_type" />
                                </p>
                                <p>
                                    <strong>Last Visited:</strong>
                                    <t t-esc="appointment.sh_last_visited" />
                                </p>
                                <p>
                                    <strong>Case Charges:</strong>
                                    <t t-esc="appointment.sh_expected_revenue" />
                                </p>
                            </div>

                            <!-- Optional Table Section -->

                            <div class="mt-5">
                                <h5 class="text-uppercase text-dark mb-3">Summary</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <th>Disease Name</th>
                                        <td>
                                            <t
                                                t-esc="appointment.sh_disease_line.sh_disease_name.name" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Saverty</th>
                                        <td>
                                            <t t-esc="appointment.sh_disease_line.sh_severity" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Medicine Name</th>
                                        <td>
                                            <t
                                                t-esc="appointment.sh_prescription_line.sh_medicine_id.name" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Medicine Type</th>
                                        <td>
                                            <t
                                                t-esc="appointment.sh_prescription_line.sh_medicine_type_id.name" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Dosage Duration</th>
                                        <td>
                                            <t
                                                t-esc="appointment.sh_prescription_line.sh_dosage_duration" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Morning</th>
                                        <td>
                                            <t t-esc="appointment.sh_prescription_line.sh_morning" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Afternoon</th>
                                        <td>
                                            <t t-esc="appointment.sh_prescription_line.sh_afternoon" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Evening</th>
                                        <td>
                                            <t t-esc="appointment.sh_prescription_line.sh_evening" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Night</th>
                                        <td>
                                            <t t-esc="appointment.sh_prescription_line.sh_night" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Late Night</th>
                                        <td>
                                            <t
                                                t-esc="appointment.sh_prescription_line.sh_late_night" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Instruction</th>
                                        <td>
                                            <t
                                                t-if="appointment.sh_prescription_line.sh_instruction == 'after_meal'">After
                                                Meal</t>
                                            <t
                                                t-if="appointment.sh_prescription_line.sh_instruction == 'before_meal'">Before
                                                Meal</t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <br />
                            <hr />
                            <div class="container my-5">
                                <h2>Communication history</h2>
                                <t t-call="portal.message_thread">
                                    <t t-set="object" t-value="appointment"></t>
                                </t>
                            </div>

                        </div>
                    </div>
                </div>

            </t>
        </template>


        <!-- Custom Fields in My Details -->

        <template id="portal_my_details_fields_custom" inherit_id="portal.portal_my_details_fields">
            <xpath expr="//div[contains(@class, 'clearfix')]" position="before">

                <div t-attf-class="mb-3 col-xl-6">
                    <label for="sh_gender">Gender</label>
                    <select name="sh_gender" class="form-control" id="sh_gender">
                        <option t-att-selected="partner.sh_gender == 'male'" value="male">Male</option>
                        <option t-att-selected="partner.sh_gender == 'female'" value="female">Female</option>
                        <option t-att-selected="partner.sh_gender == 'other'" value="other">Other</option>
                    </select>
                </div>

                <div
                    t-attf-class="mb-3 col-xl-6">
                    <label for="sh_birth_date">Birth Date</label>
                    <input type="date" class="form-control" name="sh_birth_date"
                        t-att-value="partner.sh_birth_date or ''" />
                </div>

                <div
                    t-attf-class="mb-3 col-xl-6">
                    <label for="sh_blood_group">Blood Group</label>
                    <select name="sh_blood_group" class="form-control" id="sh_blood_group">
                        <option t-att-selected="partner.sh_blood_group == 'a+'" value="a+">A+</option>
                        <option t-att-selected="partner.sh_blood_group == 'a-'" value="a-">A-</option>
                        <option t-att-selected="partner.sh_blood_group == 'b+'" value="b+">B+</option>
                        <option t-att-selected="partner.sh_blood_group == 'b-'" value="b-">B-</option>
                        <option t-att-selected="partner.sh_blood_group == 'ab+'" value="ab+">AB+</option>
                        <option t-att-selected="partner.sh_blood_group == 'ab-'" value="ab-">AB-</option>
                        <option t-att-selected="partner.sh_blood_group == 'o+'" value="o+">O+</option>
                        <option t-att-selected="partner.sh_blood_group == 'o-'" value="o-">O-</option>
                    </select>
                </div>

            </xpath>

            <xpath expr="//select[@name='country_id']/.." position="after">
                <div class="col-12 d-none d-xl-block">
                    <strong class="form-text text-muted">
                        Medical Details
                    </strong>
                </div>

                <!-- <div class="mb-3 col-xl-6">
                    <label class="col-form-label">Allergy</label>
                    <div class="form-check" t-foreach="allergies" t-as="algy">
                        <input type="checkbox"
                            class="form-check-input"
                            name="sh_allergy_ids"
                            t-att-id="'%s' % algy.id"
                            t-att-value="algy.id"
                            t-att-checked="algy.id in (sh_allergy_ids or partner.sh_allergy_ids.ids)" />
                        <label class="form-check-label" t-att-for="'%s' % algy.id">
                            <t t-esc="algy.name" />
                        </label>
                    </div>
                </div> -->

                <div class="mb-3 col-xl-6">
                    <label class="col-form-label">Allergy</label>
                    <t t-foreach="allergies" t-as="algy">
                        <div class="form-check">
                            <input type="checkbox"
                                class="form-check-input"
                                name="sh_allergy_ids"
                                t-att-id="'algy_%s' % algy.id"
                                t-att-value="algy.id"
                                t-att-checked="'checked' if algy.id in (sh_allergy_ids or partner.sh_allergy_ids.ids) else None" />
                            <label class="form-check-label" t-att-for="'algy_%s' % algy.id">
                                <t t-esc="algy.name" />
                            </label>
                        </div>
                    </t>
                </div>


                <div class="mb-3 col-xl-6">
                    <label class="col-form-label">Mental Health Problem</label>
                    <div class="form-check" t-foreach="mental_problems" t-as="mhp">
                        <input type="checkbox"
                            class="form-check-input"
                            name="sh_mental_health_problem_ids"
                            t-att-id="'%s' % mhp.id"
                            t-att-value="mhp.id"
                            t-att-checked="mhp.id in (sh_mental_health_problem_ids or partner.sh_mental_health_problem_ids.ids)" />
                        <label class="form-check-label" t-att-for="'%s' % mhp.id">
                            <t t-esc="mhp.name" />
                        </label>
                    </div>
                </div>

                <div class="mb-3 col-xl-6">
                    <label class="col-form-label">Life Style Fector</label>
                    <div class="form-check" t-foreach="lifestyles" t-as="ls">
                        <input type="checkbox"
                            class="form-check-input"
                            name="sh_life_style_fector_ids"
                            t-att-id="'%s' % ls.id"
                            t-att-value="ls.id"
                            t-att-checked="ls.id in (sh_life_style_fector_ids or partner.sh_life_style_fector_ids.ids)" />
                        <label class="form-check-label" t-att-for="'%s' % ls.id">
                            <t t-esc="ls.name" />
                        </label>
                    </div>
                </div>

                <div class="mb-3 col-xl-6">
                    <label class="col-form-label">Chronic Conditions</label>
                    <div class="form-check" t-foreach="cronics" t-as="condition">
                        <input type="checkbox"
                            class="form-check-input"
                            name="sh_cronic_condition_ids"
                            t-att-id="'cronic_%s' % condition.id"
                            t-att-value="condition.id"
                            t-att-checked="condition.id in (sh_cronic_condition_ids or partner.sh_cronic_condition_ids.ids)" />
                        <label class="form-check-label" t-att-for="'cronic_%s' % condition.id">
                            <t t-esc="condition.name" />
                        </label>
                    </div>
                </div>


                <div
                    t-attf-class="mb-3 #{error.get('sh_dietary_preferences') and 'o_has_error' or ''} col-xl-6">
                    <div class="col-xl-6">
                        <label for="sh_dietary_preferences">Dietary Preferences</label>
                        <select name="sh_dietary_preferences" class="form-control"
                            id="sh_dietary_preferences">
                            <option t-att-selected="partner.sh_dietary_preferences == 'vegetarian'"
                                value="vegetarian">Vegetarian</option>
                            <option t-att-selected="partner.sh_dietary_preferences == 'gluten_free'"
                                value="gluten_free">Gluten-Free</option>
                            <option
                                t-att-selected="partner.sh_dietary_preferences == 'non_vegetarian'"
                                value="non_vegetarian">Non Vegetarian</option>
                            <option t-att-selected="partner.sh_dietary_preferences == 'vegan'"
                                value="vegan">Vegan</option>
                        </select>
                    </div>
                </div>

                <div
                    t-attf-class="mb-3 col-xl-6">
                    <div class="col-xl-6">
                        <label for="sh_regular_medicine">Current Medication</label>
                        <input type="text" class="form-control" name="sh_regular_medicine"
                            t-att-value="partner.sh_regular_medicine or ''" />
                    </div>
                </div>


                <div
                    t-attf-class="mb-3 col-xl-6">
                    <div class="col-xl-6">
                        <label for="sh_mobility_status">Mobility Status</label>
                        <select name="sh_mobility_status" class="form-control"
                            id="sh_mobility_status">
                            <option t-att-selected="partner.sh_mobility_status == 'wheelchair'"
                                value="wheelchair">Wheelchair</option>
                            <option t-att-selected="partner.sh_mobility_status == 'walker'"
                                value="walker">Walker</option>
                            <option
                                t-att-selected="partner.sh_mobility_status == 'crutches'"
                                value="crutches">Crutches</option>
                        </select>
                    </div>
                </div>

                <div
                    t-attf-class="mb-3 col-xl-6">
                    <div class="col-xl-6">
                        <label for="sh_report">Report</label>
                        <input type="file" class="form-control" name="sh_report"
                            t-att-value="partner.sh_report or ''" />
                    </div>
                </div>

            </xpath>
        </template>
    </data>
</odoo>