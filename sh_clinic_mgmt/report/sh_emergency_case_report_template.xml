<odoo>
    <template id="emergency_cases_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <br />
                <br />
                <div class="page">
                    <h2>Emergency Cases Report</h2>
                    <p>
                        <strong>From:</strong>
                        <t t-esc="data['from_date']" />
                        <strong> To: </strong>
                        <t t-esc="data['to_date']" />
                    </p>
                    <div class="col-4">
                        <t t-if="results">
                            <table class="o_has_total_table table o_main_table"
                                style="text-align: center;">
                                <thead>
                                    <tr>
                                        <td>Emergency Count</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="results" t-as="row">
                                        <tr>
                                            <td>
                                                <span t-esc="row['emergency_count']" />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>