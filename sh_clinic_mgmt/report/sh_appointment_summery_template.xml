<odoo>
    <template id="appointment_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Appointment Summary</h2>
                    <!-- <p t-if="data">
                        <strong>From:</strong>
                        <t t-esc="data.get('from_date')" />
                        <strong>To:</strong>
                        <t t-esc="data.get('to_date')" />
                    </p>
                    <t t-if="doctor">
                        <p>
                            <strong>Doctor:</strong>
                            <t t-esc="doctor.name" />
                        </p>
                    </t> -->

                    <p style="margin-bottom: 30px;" t-if="data">
                        <strong>Date Range:</strong> <t t-esc="data.get('from_date')" /> to <t
                            t-esc="data.get('to_date')" />
                    </p>
                    <t t-if="doctor">
                        <br />
                        <strong>Doctor:</strong>
                        <t t-esc="doctor.name" />
                    </t>

                    <table
                        style="margin: 0 auto; border-collapse: collapse; width: 90%; font-size: 14px;">
                        <thead style="background-color: #f2f2f2;">
                            <tr>
                                <th style="border: 1px solid #000; padding: 8px;">Date</th>
                                <th style="border: 1px solid #000; padding: 8px;">Total</th>
                                <th style="border: 1px solid #000; padding: 8px;">Completed</th>
                                <th style="border: 1px solid #000; padding: 8px;">Canceled</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="summary" t-as="day">
                                <tr>
                                    <td style="border: 1px solid #000; padding: 8px;">
                                        <t t-esc="day['date']" />
                                    </td>
                                    <td style="border: 1px solid #000; padding: 8px;">
                                        <t t-esc="day['total']" />
                                    </td>
                                    <td style="border: 1px solid #000; padding: 8px;">
                                        <t t-esc="day['completed_appointment']" />
                                    </td>
                                    <td style="border: 1px solid #000; padding: 8px;">
                                        <t t-esc="day['cancelled_appointment']" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>