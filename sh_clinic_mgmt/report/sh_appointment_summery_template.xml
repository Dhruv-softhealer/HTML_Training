<odoo>
    <template id="appointment_summary_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <br />
                <br />
                <br />
                <div class="page">
                    <h2>Appointment Summary</h2>
                    <t t-if="doctor">
                        <p>
                            <strong>Doctor:</strong>
                            <t t-esc="doctor.name" />
                        </p>
                    </t>
                    <p>
                        <strong>From:</strong>
                        <t t-esc="data['from_date']" />
                        <strong> To </strong>
                        <t t-esc="data['to_date']" />
                    </p>
                    <table class="o_has_total_table table o_main_table">
                        <thead>
                            <tr style="background-color: #e8e8e8; border: 1px solid #ccc;">
                                <th
                                    style="padding: 8px; border: 1px solid #ccc; text-align: center;">
                                    Date</th>
                                <th
                                    style="padding: 8px; border: 1px solid #ccc; text-align: center;">
                                    Total</th>
                                <th
                                    style="padding: 8px; border: 1px solid #ccc; text-align: center;">
                                    Completed</th>
                                <th
                                    style="padding: 8px; border: 1px solid #ccc; text-align: center;">
                                    Cancelled</th>
                                <th
                                    style="padding: 8px; border: 1px solid #ccc; text-align: center;">
                                    Pending</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="summary" t-as="line">
                                <tr>
                                    <td
                                        style="padding: 8px; border: 1px solid #ccc; text-align: center;">
                                        <t t-esc="line['date']" />
                                    </td>
                                    <td
                                        style="padding: 8px; border: 1px solid #ccc; text-align: center;">
                                        <t t-esc="line['total']" />
                                    </td>
                                    <td
                                        style="padding: 8px; border: 1px solid #ccc; text-align: center;">
                                        <t t-esc="line['completed_appointment']" />
                                    </td>
                                    <td
                                        style="padding: 8px; border: 1px solid #ccc; text-align: center;">
                                        <t t-esc="line['cancelled_appointment']" />
                                    </td>
                                    <td
                                        style="padding: 8px; border: 1px solid #ccc; text-align: center;">
                                        <t t-esc="line['pending']" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>