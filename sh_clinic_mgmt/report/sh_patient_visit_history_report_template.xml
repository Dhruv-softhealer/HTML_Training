<odoo>
    <template id="patient_visit_history_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <br />
                <br />
                <div class="page">
                    <h2>Patient Visit History</h2>
                    <p>
                        <strong>From:</strong>
                        <t t-esc="data['from_date']" />
                        <strong> To: </strong>
                        <t t-esc="data['to_date']" />
                    </p>
                    <t t-if="results">
                        <table class="o_has_total_table table o_main_table"
                            style="text-align: center;">
                            <thead>
                                <tr>
                                    <td>Patient Name</td>
                                    <td>Patient ID</td>
                                    <td>Total Visits</td>
                                    <td>Last Visit Date</td>
                                    <td>Assigned Doctor</td>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="results" t-as="res">
                                    <tr>
                                        <td>
                                            <span t-esc="res['patient_name']" />
                                        </td>
                                        <td>
                                            <span t-esc="'P' + str(res['patient_id']).zfill(4)" />
                                        </td>
                                        <td>
                                            <span t-esc="res['total_visits']" />
                                        </td>
                                        <td>
                                            <span t-esc="res['last_visit_date']" />
                                        </td>
                                        <td>
                                            <span
                                                t-esc="env['hr.employee'].browse(res['doctor_name']).name or 'N/A'" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>