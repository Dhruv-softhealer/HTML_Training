<odoo>
    <template id="medicine_stock_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <br/>
                <br/>
                <div class="page">
                    <h2>Medicine Stock Report</h2>
                    <p>
                        <strong>Generated On:</strong>
                        <t t-esc="datetime.datetime.now().strftime('%Y-%m-%d')" />
                    </p>
                    <t t-if="results">
                        <table class="o_has_total_table table o_main_table" style="text-align: center;">
                            <thead>
                                <tr>
                                    <td>Medicine Name</td>
                                    <td>On Hand Stock</td>
                                    <td>Expiry Date</td>
                                    <td>Reorder Level</td>
                                    <td>Status</td>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="results" t-as="res">
                                    <tr>
                                        <td><span t-esc="res['medicine_name']['en_US']"/></td>
                                        <td><span t-esc="'{} strips'.format(int(res['on_hand_stock']))" /></td>
                                        <td><span t-esc="res['expiry_date'] or 'N/A'"/></td>
                                        <td><span t-esc="'{} strips'.format(int(res['reorder_level']))" /></td>
                                        <td><span t-esc="res['status']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
            </t>
        </template>
</odoo>