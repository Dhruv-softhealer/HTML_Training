<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="monthly_revenue_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <br />
                <div class="page">
                    <h2>Monthly Revenue Report</h2>
                    <p>
                        <strong>Month:</strong>
                        <t t-esc="data['month']" />
                    </p>
                    <t t-if="results">
                        <table class="o_has_total_table table o_main_table"
                            style="text-align: center;">
                            <thead>
                                <tr style="font-weight: bold;">
                                    <td>Month</td>
                                    <td>Total Revenue</td>
                                    <td>Paid Amount</td>
                                    <td>Pending Amount</td>
                                    <td>Refunds</td>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="results" t-as="res">
                                    <tr>
                                        <td>
                                            <span t-esc="res['month']" />
                                        </td>
                                        <td>
                                            <span t-esc="'₹' + '{:,.0f}'.format(res['total_revenue'])" />
                                        </td>
                                        <td>
                                            <span t-esc="'₹' + '{:,.0f}'.format(res['paid_amount'])" />
                                        </td>
                                        <td>
                                            <span
                                                t-esc="'₹' + '{:,.0f}'.format(res['pending_amount'])" />
                                        </td>
                                        <td>
                                            <span t-esc="'₹' + '{:,.0f}'.format(res['refunds'])" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
        