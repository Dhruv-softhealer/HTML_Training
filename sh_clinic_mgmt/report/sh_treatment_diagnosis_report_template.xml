<odoo>
    <template id="treatment_diagnosis_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <br />
                <br />
                <div class="page">
                    <h2>Treatment and Diagnosis Report</h2>
                    <p>
                        <strong>From:</strong>
                        <t t-esc="data['from_date']" />
                        <strong>To:</strong>
                        <t t-esc="data['to_date']" />
                    </p>
                    <t t-if="results">
                        <table class="o_has_total_table table o_main_table"
                            style="text-align: center;">
                            <thead>
                                <tr>
                                    <td>Disease Name</td>
                                    <td>Total Cases</td>
                                    <td>Treated Successfully</td>
                                    <td>Ongoing Treatment</td>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="results" t-as="res">
                                    <tr>
                                        <td>
                                            <span t-esc="res['disease_name']" />
                                        </td>
                                        <td>
                                            <span t-esc="res['total_cases']" />
                                        </td>
                                        <td>
                                            <span t-esc="res['treated_successfully']" />
                                        </td>
                                        <td>
                                            <span t-esc="res['ongoing_treatment']" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>