<odoo>
    <template id="disease_wise_patient_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <br />
                <br />
                <div class="page">
                    <h2>Disease Wise Patient Report</h2>
                    <p>
                        <strong>From:</strong>
                        <t t-esc="data['from_date']" />
                        <strong> To: </strong>
                        <t t-esc="data['to_date']" />
                    </p>
                    <div class="col-4">
                        <table class="o_has_total_table table o_main_table"
                            style="text-align: center;">
                            <thead>
                                <tr>
                                    <td>Disease Name</td>
                                    <td>Patient Count</td>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="results" t-as="row">
                                    <tr>
                                        <td>
                                            <span t-esc="row['disease_name']" />
                                        </td>
                                        <td>
                                            <span t-esc="row['patient_count']" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>