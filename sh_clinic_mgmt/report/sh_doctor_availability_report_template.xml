<odoo>
    <template id="doctor_availability_template">
        <t t-call="web.external_layout">
            <main class="page">
                <h2 class="text-center">Doctor Availability Report</h2>
                <table class="o_has_total_table table o_main_table">
                    <thead>
                        <tr>
                            <th>Doctor Name</th>
                            <th>Department</th>
                            <th>Available Days</th>
                            <th>Shift Timing</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="records" t-as="rec">
                            <tr>
                                <td>
                                    <t t-esc="rec['doctor_name']" />
                                </td>
                                <td>
                                    <t t-esc="rec['department_name']" />
                                </td>
                                <td>
                                    <t t-esc="rec['available_days']" />
                                </td>
                                <td>
                                    <t t-esc="rec['shift_timing']" />
                                </td>
                                <td>
                                    <t t-esc="rec['status']" />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </main>
        </t>
    </template>
</odoo>