<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medicine_stock_report_wizard_form" model="ir.ui.view">
        <field name="name">medicine.stock.report.wizard</field>
        <field name="model">sh.medicine.stock.report</field>
        <field name="arch" type="xml">
            <form string="Medicine Stock Report">
                <group>
                    <field name="medicine_id"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Download PDF Report" type="object" class="btn-primary"/>
                    <button name="action_excel_report" string="Download Excel Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medicine_stock_report_wizard" model="ir.actions.act_window">
        <field name="name">Medicine Stock Report</field>
        <field name="res_model">sh.medicine.stock.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>