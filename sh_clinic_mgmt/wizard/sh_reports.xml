    <record id="action_treatment_diagnosis_report" model="ir.actions.report">
        <field name="name">Treatment and Diagnosis Report</field>
        <field name="model">sh.treatment.diagnosis.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_clinic_mgmt.treatment_diagnosis_report_template</field>
        <field name="report_file">sh_clinic_mgmt.treatment_diagnosis_report_template</field>
