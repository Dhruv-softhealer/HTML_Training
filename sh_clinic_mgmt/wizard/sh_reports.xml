        <field name="name">Disease Wise Patient Report</field>
        <field name="model">sh.disease.wise.patient.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_clinic_mgmt.disease_wise_patient_report_template</field>
