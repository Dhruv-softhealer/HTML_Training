    <record id="action_emergency_cases_report" model="ir.actions.report">
        <field name="name">Emergency Cases Report</field>
        <field name="model">sh.emergency.cases.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_clinic_mgmt.emergency_cases_report_template</field>
        <field name="report_file">sh_clinic_mgmt.emergency_cases_report_template</field>
