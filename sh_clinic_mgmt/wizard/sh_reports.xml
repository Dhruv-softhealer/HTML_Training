<odoo>

    <!-- =================== Paper Format ================== -->

    <record id="paperformat_event_full_page" model="report.paperformat">
        <field name="name">Custom Paperformat for the Event Full Page Ticket report</field>
        <field name="default" eval="False" />
        <field name="disable_shrinking" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- =================== Report For Portal ================== -->

    <record id="report_appointment_action" model="ir.actions.report">
        <field name="name">Prescription</field>
        <field name="model">sh.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_clinic_mgmt.report_appointment</field>
        <field name="report_file">sh_clinic_mgmt.report_appointment</field>
        <field name="print_report_name">'Appointment'</field>
        <field name="binding_model_id" ref="model_sh_appointment"/>
        <field name="binding_type">report</field>
    </record>

    <!-- =================== Report For Backend ================== -->

    <!-- 1. Daily Appointment Summary -->

    <record id="action_appointment_summary_report" model="ir.actions.report">
        <field name="name">Appointment Report</field>
        <field name="model">sh.appointment.summary.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_clinic_mgmt.appointment_summary_report_template</field>
        <field name="report_file">sh_clinic_mgmt.appointment_summary_report_template</field>
        <field name="binding_type">report</field>
    </record>

    <!-- 2. Monthly Revenue Report -->

    <record id="action_monthly_revenue_report" model="ir.actions.report">
        <field name="name">Monthly Revenue Report</field>
        <field name="model">sh.monthly.revenue.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_clinic_mgmt.monthly_revenue_report_template</field>
        <field name="report_file">sh_clinic_mgmt.monthly_revenue_report_template</field>
        <field name="print_report_name">'Monthly Revenue Report'</field>
        <field name="binding_type">report</field>
    </record>

    <!-- 3. Doctor Availability Report -->

    <record id="doctor_availability_action" model="ir.actions.report">
        <field name="name">Slots</field>
        <field name="model">sh.doctor.availability.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_clinic_mgmt.doctor_availability_template</field>
        <field name="report_file">sh_clinic_mgmt.doctor_availability_template</field>
        <field name="binding_type">report</field>
    </record>

    <!-- 4. Patient Visit History Report -->

    <record id="action_patient_visit_history_report" model="ir.actions.report">
        <field name="name">Patient Visit History</field>
        <field name="model">sh.patient.visit.history.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_clinic_mgmt.patient_visit_history_report_template</field>
        <field name="report_file">sh_clinic_mgmt.patient_visit_history_report_template</field>
        <field name="print_report_name">'Patient Visit History'</field>
        <field name="binding_type">report</field>
    </record>

    <!-- 5. Medicine Stock Report -->

    <record id="action_medicine_stock_report" model="ir.actions.report">
        <field name="name">Medicine Stock Report</field>
