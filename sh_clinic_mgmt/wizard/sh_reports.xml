    <!-- 6. Doctor’s Performance Report -->

    <record id="action_doctor_performance_report" model="ir.actions.report">
        <field name="name">Doctor's Performance Report</field>
        <field name="model">sh.doctor.performance.wizard</field>
        <field name="report_type">qweb-pdf</field>
