    <record id="action_patient_demographics_report" model="ir.actions.report">
        <field name="name">Patient Demographics Report</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_clinic_mgmt.patient_demographics_report_template</field>
