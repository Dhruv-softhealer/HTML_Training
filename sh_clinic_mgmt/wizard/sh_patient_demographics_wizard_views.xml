<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_patient_demographics_report_wizard" model="ir.ui.view">
        <field name="name">sh.patient.demog.report.wizard</field>
        <field name="model">sh.patient.demographics.wizard</field>
        <field name="arch" type="xml">
            <form string=" Report">
                <h2>Select Type of Report</h2>
                <footer>
                    <button name="action_print_report" string="Download PDF Report" type="object" class="btn-primary"/>
                    <button name="action_excel_report" string="Download Excel Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_patient_demographics_report_wizard" model="ir.actions.act_window">
        <field name="name">Patient Demographic Report</field>
        <field name="res_model">sh.patient.demographics.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
