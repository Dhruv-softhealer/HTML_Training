<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="doctor_avail_report_wizard_form" model="ir.ui.view">
        <field name="name">sh.doctor.avail.report.wizard.form</field>
        <field name="model">sh.doctor.availability.report</field>
        <field name="arch" type="xml">
            <form string="Doctor Availability Report">
                <h1>Select type of Report</h1>
                <footer>
                    <button name="action_print_report" string="Download PDF Report" type="object" class="btn-primary"/>
                    <button name="action_excel_report" string="Download Excel Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_doctor_avail_report_wizard" model="ir.actions.act_window">
        <field name="name">Doctor Availability Report</field>
        <field name="res_model">sh.doctor.availability.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>