<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_disease_wise_patient_report_wizard" model="ir.ui.view">
        <field name="name">disease.wise.patient.report.wizard</field>
        <field name="model">sh.disease.wise.patient.wizard</field>
        <field name="arch" type="xml">
            <form string="Disease Wise Patient Report">
                <group>
                    <field name="from_date" required="1" />
                    <field name="to_date" required="1" />
                    <field name="disease_ids"  widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Download PDF Report" type="object"
                        class="btn-primary" />
                    <button name="action_excel_report" string="Download Excel Report" type="object"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_disease_wise_patient_report_wizard" model="ir.actions.act_window">
        <field name="name">Disease Wise Patient Report</field>
        <field name="res_model">sh.disease.wise.patient.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>