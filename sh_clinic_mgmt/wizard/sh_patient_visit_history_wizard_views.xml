<odoo>
    <record id="view_patient_visit_history_report_wizard_form" model="ir.ui.view">
        <field name="name">patient.visit.history.report.wizard</field>
        <field name="model">sh.patient.visit.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Patient Visit History">
                <group>
                    <field name="from_date" required="1" />
                    <field name="to_date" required="1" />
                </group>
                <footer>
                    <button name="action_print_report" string="Download PDF Report" type="object"
                        class="btn-primary" />
                    <button name="action_excel_report" string="Download Excel Report" type="object"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_patient_visit_history_report_wizard" model="ir.actions.act_window">
        <field name="name">Patient Visit History</field>
        <field name="res_model">sh.patient.visit.history.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>