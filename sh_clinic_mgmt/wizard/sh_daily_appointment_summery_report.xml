<odoo>
    <record id="view_appointment_summary_report_wizard" model="ir.ui.view">
        <field name="name">appointment.summary.report.wizard.form</field>
        <field name="model">sh.appointment.summary.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Appointment Summary Report">
                <group>
                    <field name="sh_company_id" invisible='1' />
                    <field name="sh_doctor_domain_ids" invisible='1' />
                    <field name="from_date" />
                    <field name="to_date" />
                    <field name="doctor_id" />
                </group>
                <footer>
                    <button name="action_print_report" type="object" string="Print PDF Report"
                        class="btn-primary" />
                    <button name="action_excel_report" type="object" string="Print Excel Report"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_appointment_summary_report_wizard" model="ir.actions.act_window">
        <field name="name">Appointment Summary</field>
        <field name="res_model">sh.appointment.summary.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>