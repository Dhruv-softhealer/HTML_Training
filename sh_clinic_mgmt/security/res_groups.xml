<odoo>
    <record id="sh_clinic_access_group" model="ir.module.category">
        <field name="name">Clinic Access</field>
    </record>

<!-- ============================= Receptioniest ================================ -->

    <record id="clinic_group_receptioniest" model="res.groups">
        <field name="name">Receptioniest</field>
        <field name="category_id" ref="sh_clinic_mgmt.sh_clinic_access_group" />
        <field name="comment">The Receptioniest will be able to join support channels.</field>
    </record>

<!-- ============================= Doctor ================================ -->

    <record id="clinic_group_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="category_id" ref="sh_clinic_mgmt.sh_clinic_access_group" />
        <field name="comment">The Doctor will be able to join support channels.</field>
        <field name="implied_ids" eval="[(4,ref('clinic_group_receptioniest'))]"></field>
    </record>

<!-- ============================= Admin ================================ -->

    <record id="clinic_group_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="sh_clinic_mgmt.sh_clinic_access_group" />
        <field name="comment">The Admin will be able to join support channels.</field>
        <field name="implied_ids" eval="[(4,ref('clinic_group_doctor'))]"></field>
    </record>
</odoo>